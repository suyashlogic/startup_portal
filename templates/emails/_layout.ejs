<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= subject %></title>
<style>
  body{margin:0;padding:0;background:#EFEFEB;}
  p{margin:0 0 14px;}
  a{color:#A8323A;}
  @media only screen and (max-width:620px){
    .card{width:100% !important;border-radius:0 !important;}
    .pad{padding:24px 20px !important;}
    .dl-k{display:block !important;width:auto !important;padding-bottom:0 !important;}
    .dl-v{display:block !important;padding-top:2px !important;}
  }
</style>
</head>
<body style="margin:0;padding:0;background:#EFEFEB;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= subject %></div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#EFEFEB;">
<tr><td align="center" style="padding:28px 12px;">

  <table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0"
         style="width:600px;max-width:600px;background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #e3e7ef;">

    <!-- Header -->
    <tr><td align="center" style="background:#A8323A;padding:26px 24px;">
      <div style="font-family:'Times New Roman',Times,serif;font-size:26px;font-weight:bold;color:#ffffff;letter-spacing:.3px;">🎓 IncuPortal</div>
      <div style="font-family:'Times New Roman',Times,serif;font-size:13px;color:rgba(255,255,255,.8);margin-top:4px;">Student Innovation Platform</div>
    </td></tr>
    <tr><td style="height:4px;background:#F1AB27;font-size:0;line-height:0;">&nbsp;</td></tr>

    <!-- Body -->
    <tr><td class="pad" style="padding:32px 36px;font-family:'Times New Roman',Times,serif;font-size:16px;line-height:1.65;color:#2B140A;">

      <p style="font-size:18px;color:#662C11;"><strong>Hello <%= name %>,</strong></p>

      <% if (badge) {
           const tones = { approved:['#d1fae5','#065f46'], rejected:['#fee2e2','#991b1b'], pending:['#FCEFD6','#8A5A0B'] };
           const t = tones[badge.tone] || tones.pending; %>
        <p><span style="display:inline-block;background:<%= t[0] %>;color:<%= t[1] %>;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;letter-spacing:.8px;text-transform:uppercase;padding:5px 12px;border-radius:999px;"><%= badge.text %></span></p>
      <% } %>

      <%- body %>

      <% if (details.length) { %>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
             style="margin:20px 0;background:#f8f9fa;border:1px solid #e3e7ef;border-radius:10px;">
        <% details.forEach(function(d, i){ %>
        <tr>
          <td class="dl-k" width="36%" valign="top" style="padding:10px 16px <%= i === details.length-1 ? '12px' : '0' %>;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:.6px;color:#8A7A70;"><%= d[0] %></td>
          <td class="dl-v" valign="top" style="padding:8px 16px <%= i === details.length-1 ? '12px' : '0' %>;font-family:'Times New Roman',Times,serif;font-size:15px;color:#2B140A;"><%= d[1] %></td>
        </tr>
        <% }); %>
      </table>
      <% } %>

      <% if (cta) { %>
      <table role="presentation" cellpadding="0" cellspacing="0" style="margin:26px 0 8px;">
        <tr><td style="background:#CE4048;border-radius:999px;">
          <a href="<%= cta.url %>" style="display:inline-block;padding:13px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;"><%= cta.label %></a>
        </td></tr>
      </table>
      <p style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#8A7A70;">Button not working? Paste this link into your browser:<br><a href="<%= cta.url %>" style="color:#8A7A70;word-break:break-all;"><%= cta.url %></a></p>
      <% } %>

      <p style="margin-top:26px;">Regards,<br><strong>IncuPortal Incubation Cell</strong></p>
    </td></tr>

    <!-- Footer -->
    <tr><td style="background:#fafbfc;border-top:1px solid #e3e7ef;padding:18px 36px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#8A7A70;">
      This is an automated message from IncuPortal, please do not reply.
      <% if (showPrefsLink) { %><br><a href="<%= prefsUrl %>" style="color:#8A7A70;">Manage email preferences</a><% } else { %><br>You are receiving this because it relates to the security of your account.<% } %>
      <br>&copy; <%= year %> IncuPortal
    </td></tr>
  </table>

</td></tr>
</table>
</body>
</html>
