<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= startup.title %> — Mentor View</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
          <div>
            <h1 class="mb-2">
              <i class="bi bi-rocket-takeoff me-2"></i><%= startup.title %>
            </h1>
            <div class="d-flex align-items-center flex-wrap gap-2">
              <!-- Student pill -->
              <span class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill"
                style="background:rgba(255,255,255,.18);color:#fff;font-size:.8rem;font-weight:600;">
                <i class="bi bi-person-circle" style="font-size:.85rem;"></i>
                <%= startup.student_name %>
              </span>
              <span class="badge bg-white text-dark fw-semibold" style="font-size:.75rem;">
                <i class="bi bi-tag me-1"></i><%= startup.domain %>
              </span>
              <span class="badge badge-<%= startup.stage %>"><%= startup.stage %></span>
              <span class="badge badge-<%= startup.status %> d-inline-flex align-items-center gap-1">
                <% if (startup.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.6rem;"></i>
                <% } else if (startup.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.6rem;"></i>
                <% } else { %><i class="bi bi-clock" style="font-size:.6rem;"></i><% } %>
                <%= startup.status %>
              </span>
            </div>
          </div>
          <a href="/mentor/dashboard" class="btn align-self-start">
            <i class="bi bi-arrow-left me-1"></i> Back
          </a>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <!-- ── Quick stat strip ── -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 d-flex align-items-center gap-3"
            style="background:#fff;border:1px solid #e3e7ef;">
            <i class="bi bi-chat-dots text-primary" style="font-size:1.3rem;"></i>
            <div>
              <div class="fw-bold" style="font-size:1.3rem;color:var(--ip-red);line-height:1;"><%= feedback.length %></div>
              <div style="font-size:.7rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Feedbacks</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 d-flex align-items-center gap-3"
            style="background:#fff;border:1px solid #e3e7ef;">
            <i class="bi bi-bar-chart" style="font-size:1.3rem;color:#7c3aed;"></i>
            <div>
              <div class="fw-bold" style="font-size:1.3rem;color:#7c3aed;line-height:1;"><%= progress.length %></div>
              <div style="font-size:.7rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Updates</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 d-flex align-items-center gap-3"
            style="background:#fff;border:1px solid #e3e7ef;">
            <i class="bi bi-calendar3" style="font-size:1.3rem;color:#d97706;"></i>
            <div>
              <div class="fw-bold" style="font-size:.85rem;color:#374151;line-height:1.3;">
                <%= new Date(startup.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
              </div>
              <div style="font-size:.7rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Submitted</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="rounded-3 p-3 d-flex align-items-center gap-3"
            style="background:#fff;border:1px solid #e3e7ef;">
            <% if (startup.pitch_deck_url) { %>
              <i class="bi bi-file-earmark-slides text-primary" style="font-size:1.3rem;"></i>
              <div>
                <a href="<%= startup.pitch_deck_url %>" target="_blank"
                  class="fw-semibold text-decoration-none" style="font-size:.845rem;color:var(--ip-red);">
                  View deck <i class="bi bi-box-arrow-up-right ms-1" style="font-size:.7rem;"></i>
                </a>
                <div style="font-size:.7rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Pitch Deck</div>
              </div>
            <% } else { %>
              <i class="bi bi-file-earmark-x" style="font-size:1.3rem;color:#d1d5db;"></i>
              <div>
                <div class="fw-semibold" style="font-size:.845rem;color:#9ca3af;">No deck</div>
                <div style="font-size:.7rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Pitch Deck</div>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ── Two-column layout ── -->
      <div class="row g-4 align-items-start">

        <!-- ──── LEFT COLUMN ──── -->
        <div class="col-lg-6">

          <!-- Startup Info -->
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-file-text me-1"></i>Startup info</div>
              <p style="font-size:.9rem;color:#374151;line-height:1.8;"><%= startup.description %></p>
            </div>
          </div>

          <!-- Give Feedback -->
          <div class="card border-0 shadow-sm" style="border-radius:14px;border-top:3px solid var(--ip-red) !important;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-chat-square-text me-1"></i>Add feedback</div>

              <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-3"
                style="background:#fdf2f2;border:1px solid #fecaca;font-size:.82rem;color:#7f1d1d;">
                <i class="bi bi-lightbulb-fill flex-shrink-0 mt-1" style="color:var(--ip-red);"></i>
                <span>Be specific and constructive — mention what's working well, key risks, and actionable next steps for the team.</span>
              </div>

              <form action="/mentor/startup/<%= startup.id %>/feedback" method="POST">
                <div class="mb-3">
                  <textarea name="feedback" class="form-control" rows="6"
                    placeholder="Share your expertise — what should the team focus on? What are the risks? What's working well?"
                    required style="font-size:.855rem;resize:vertical;"></textarea>
                  <div class="d-flex justify-content-end mt-1">
                    <span id="fbCharCount" style="font-size:.72rem;color:#9ca3af;">0 characters</span>
                  </div>
                </div>
                <button type="submit" class="btn btn-primary fw-semibold px-4" style="font-size:.875rem;">
                  <i class="bi bi-send me-2"></i>Submit Feedback
                </button>
              </form>
            </div>
          </div>

        </div><!-- /left col -->

        <!-- ──── RIGHT COLUMN ──── -->
        <div class="col-lg-6">

          <!-- Student Progress Updates -->
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-section-title mb-0"><i class="bi bi-graph-up me-1"></i>Student progress</div>
                <span class="badge bg-primary rounded-pill" style="font-size:.68rem;"><%= progress.length %></span>
              </div>

              <% if (progress.length === 0) { %>
                <div class="text-center py-4">
                  <i class="bi bi-bar-chart-line" style="font-size:2rem;color:#d1d5db;display:block;margin-bottom:.6rem;"></i>
                  <p class="text-muted mb-0" style="font-size:.845rem;">No progress updates from the team yet.</p>
                </div>
              <% } else { %>
                <div class="d-flex flex-column gap-3" style="max-height:420px;overflow-y:auto;padding-right:4px;">
                  <% progress.forEach((p, i) => { %>
                    <div class="d-flex gap-3">
                      <div class="d-flex flex-column align-items-center flex-shrink-0" style="width:18px;">
                        <div class="rounded-circle flex-shrink-0"
                          style="width:10px;height:10px;background:#7c3aed;margin-top:4px;border:2px solid #fff;box-shadow:0 0 0 2px #7c3aed;"></div>
                        <% if (i < progress.length - 1) { %>
                          <div style="width:2px;flex:1;background:#e3e7ef;margin-top:4px;min-height:20px;"></div>
                        <% } %>
                      </div>
                      <div class="pb-2 flex-grow-1">
                        <div class="text-muted mb-1" style="font-size:.72rem;font-weight:600;">
                          <i class="bi bi-calendar3 me-1"></i>
                          <%= new Date(p.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                          <% if (p.author_name) { %>
                            <span class="ms-2"><i class="bi bi-person me-1"></i><%= p.author_name %></span>
                          <% } %>
                        </div>
                        <div class="p-3 rounded-3" style="background:#f8f9fa;border:1px solid #e3e7ef;font-size:.845rem;color:#374151;line-height:1.65;">
                          <%= p.description %>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>

          <!-- All Feedback -->
          <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-section-title mb-0"><i class="bi bi-chat-dots me-1"></i>All feedback</div>
                <span class="badge bg-primary rounded-pill" style="font-size:.68rem;"><%= feedback.length %></span>
              </div>

              <% if (feedback.length === 0) { %>
                <div class="text-center py-4">
                  <i class="bi bi-chat-square-dots" style="font-size:2rem;color:#d1d5db;display:block;margin-bottom:.6rem;"></i>
                  <p class="text-muted mb-0" style="font-size:.845rem;">No feedback submitted yet. Be the first to guide this startup!</p>
                </div>
              <% } else { %>
                <div class="d-flex flex-column gap-3" style="max-height:420px;overflow-y:auto;padding-right:4px;">
                  <% feedback.forEach(f => { %>
                    <div class="p-3 rounded-3" style="background:#f8f9fa;border:1px solid #e3e7ef;">
                      <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="avatar-circle flex-shrink-0" style="width:28px;height:28px;font-size:.72rem;">
                          <%= f.mentor_name.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <span class="fw-semibold" style="font-size:.82rem;color:#111;"><%= f.mentor_name %></span>
                          <span class="text-muted ms-2" style="font-size:.73rem;">
                            <i class="bi bi-calendar3 me-1"></i>
                            <%= new Date(f.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                          </span>
                        </div>
                        <% if (f.mentor_name === user.name) { %>
                          <span class="badge ms-auto" style="background:#fdf2f2;color:var(--ip-red);font-size:.62rem;">You</span>
                        <% } %>
                      </div>
                      <p class="mb-0" style="font-size:.845rem;color:#374151;line-height:1.7;"><%= f.feedback %></p>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>

        </div><!-- /right col -->
      </div><!-- /row -->

    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Character counter for feedback textarea
const ta = document.querySelector('textarea[name="feedback"]');
const cc = document.getElementById('fbCharCount');
if (ta && cc) {
  ta.addEventListener('input', () => {
    cc.textContent = ta.value.length + ' characters';
  });
}
</script>
</body>
</html>
