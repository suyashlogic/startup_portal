<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Mentor Dashboard — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-person-workspace me-2"></i>Mentor Dashboard</h1>
          <p>Welcome, <strong style="color:rgba(255,255,255,.95);"><%= user.name %></strong>! Here are your assigned startups.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-white text-primary fw-semibold px-3 py-2" style="font-size:.8rem;border-radius:20px;">
            <i class="bi bi-rocket-takeoff me-1"></i>
            <%= startups.length %> Assigned
          </span>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <% if (startups.length > 0) { %>
      <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:var(--ip-red-pale);">
                <i class="bi bi-collection text-primary" style="font-size:1.15rem;"></i>
              </div>
              <div>
                <div class="stat-val"><%= startups.length %></div>
                <div class="stat-lbl">Total Assigned</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#1a7a4a;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#f0fdf4;">
                <i class="bi bi-check-circle" style="font-size:1.15rem;color:#1a7a4a;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#1a7a4a;"><%= startups.filter(s => s.status === 'approved').length %></div>
                <div class="stat-lbl">Approved</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#d97706;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#fef9ec;">
                <i class="bi bi-hourglass-split" style="font-size:1.15rem;color:#d97706;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#d97706;"><%= startups.filter(s => s.status === 'pending').length %></div>
                <div class="stat-lbl">Pending</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#7c3aed;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#f5f3ff;">
                <i class="bi bi-chat-dots" style="font-size:1.15rem;color:#7c3aed;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#7c3aed;"><%= startups.reduce((a, s) => a + (s.feedback_count || 0), 0) %></div>
                <div class="stat-lbl">Feedbacks Given</div>
              </div>
            </div>
          </div>
        </div>

      </div>
      <% } %>

      <!-- ── Empty state ── -->
      <% if (startups.length === 0) { %>
        <div class="card border-0 shadow-sm text-center py-5 px-4" style="border-radius:14px;">
          <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 mx-auto"
            style="width:72px;height:72px;background:var(--ip-red-pale);">
            <i class="bi bi-clipboard-x text-primary" style="font-size:2rem;"></i>
          </div>
          <h5 class="fw-bold mb-1" style="color:#111;">No startups assigned yet</h5>
          <p class="text-muted mb-0" style="font-size:.875rem;max-width:360px;margin:0 auto;">
            The admin will assign startups to you once they are approved. Check back soon!
          </p>
        </div>

      <% } else { %>

      <!-- ── Startup cards grid ── -->
      <div class="row g-4">
        <% startups.forEach(s => { %>

        <div class="col-12 col-md-6 col-xl-4">
          <div class="card border-0 shadow-sm h-100" style="border-radius:14px;transition:transform .2s,box-shadow .2s;"
            onmouseenter="this.style.transform='translateY(-3px)';this.style.boxShadow='0 10px 28px rgba(139,26,26,.1)'"
            onmouseleave="this.style.transform='';this.style.boxShadow=''">

            <!-- Status accent bar -->
            <div style="height:4px;border-radius:14px 14px 0 0;background:<%= s.status === 'approved' ? '#1a7a4a' : s.status === 'rejected' ? '#c0392b' : '#d97706' %>;"></div>

            <div class="card-body p-4 d-flex flex-column">

              <!-- Header -->
              <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                <div class="d-flex align-items-center gap-3">
                  <%
                    const domainIcons = {
                      'EdTech':'📚','HealthTech':'🏥','FinTech':'💳','AgriTech':'🌾',
                      'E-Commerce':'🛒','SaaS':'☁️','AI/ML':'🤖','IoT':'📡',
                      'Social Impact':'🌍','Other':'🔧'
                    };
                  %>
                  <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                    style="width:44px;height:44px;background:var(--ip-red-pale);font-size:1.25rem;">
                    <%= domainIcons[s.domain] || '🚀' %>
                  </div>
                  <div>
                    <h6 class="fw-bold mb-0" style="font-size:.95rem;color:#111;line-height:1.3;">
                      <%= s.title %>
                    </h6>
                    <div class="d-flex align-items-center gap-1 mt-1" style="font-size:.75rem;color:#9ca3af;">
                      <i class="bi bi-person-circle" style="font-size:.75rem;"></i>
                      <%= s.student_name %>
                    </div>
                  </div>
                </div>
                <span class="badge badge-<%= s.status %> d-inline-flex align-items-center gap-1 flex-shrink-0">
                  <% if (s.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.6rem;"></i>
                  <% } else if (s.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.6rem;"></i>
                  <% } else { %><i class="bi bi-clock" style="font-size:.6rem;"></i><% } %>
                  <%= s.status %>
                </span>
              </div>

              <!-- Description -->
              <p class="text-muted mb-3" style="font-size:.845rem;line-height:1.65;flex-grow:1;
                display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                <%= s.description %>
              </p>

              <!-- Meta badges -->
              <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                <span class="badge badge-<%= s.stage %>"><%= s.stage %></span>
                <span class="badge" style="background:#f1f5f9;color:#475569;font-size:.68rem;">
                  <i class="bi bi-tag me-1" style="font-size:.6rem;"></i><%= s.domain %>
                </span>
                <% if (s.pitch_deck_url) { %>
                  <span class="badge" style="background:#eff6ff;color:#1d4ed8;font-size:.68rem;">
                    <i class="bi bi-paperclip me-1" style="font-size:.6rem;"></i>Pitch deck
                  </span>
                <% } %>
              </div>

              <!-- Footer -->
              <div class="pt-2 border-top d-flex align-items-center justify-content-between"
                style="border-color:#e3e7ef !important;">
                <div class="d-flex align-items-center gap-3" style="font-size:.75rem;color:#9ca3af;">
                  <span title="Feedback given">
                    <i class="bi bi-chat-dots me-1"></i><%= s.feedback_count || 0 %>
                  </span>
                  <span title="Progress updates">
                    <i class="bi bi-bar-chart me-1"></i><%= s.progress_count || 0 %>
                  </span>
                </div>
                <a href="/mentor/startup/<%= s.id %>"
                  class="btn btn-primary btn-sm fw-semibold" style="font-size:.78rem;">
                  View & Feedback <i class="bi bi-arrow-right ms-1"></i>
                </a>
              </div>

            </div>
          </div>
        </div>

        <% }); %>
      </div><!-- /row -->

      <% } %>
    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
