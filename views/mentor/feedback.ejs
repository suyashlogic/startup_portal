<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>All Feedback — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-chat-dots me-2"></i>All Feedback</h1>
          <p>Every piece of feedback you've given across all assigned startups</p>
        </div>
        <span class="badge bg-white text-primary fw-semibold px-3 py-2" style="font-size:.8rem;border-radius:20px;">
          <i class="bi bi-chat-square-text me-1"></i>
          <%= feedback.length %> entry<%= feedback.length !== 1 ? 's' : '' %>
        </span>
      </div>

      <%- include('../layouts/flash') %>

      <!-- ── Stat strip ── -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#7c3aed;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#f5f3ff;">
                <i class="bi bi-chat-dots" style="font-size:1.15rem;color:#7c3aed;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#7c3aed;"><%= feedback.length %></div>
                <div class="stat-lbl">Total Feedbacks</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:var(--ip-red-pale);">
                <i class="bi bi-rocket-takeoff text-primary" style="font-size:1.15rem;"></i>
              </div>
              <div>
                <div class="stat-val"><%= [...new Set(feedback.map(f => f.startup_id))].length %></div>
                <div class="stat-lbl">Startups Covered</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#1a7a4a;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#f0fdf4;">
                <i class="bi bi-calendar-check" style="font-size:1.15rem;color:#1a7a4a;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#1a7a4a;font-size:1.1rem;">
                  <% if (feedback.length > 0) { %>
                    <%= new Date(feedback[0].created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %>
                  <% } else { %>—<% } %>
                </div>
                <div class="stat-lbl">Latest Entry</div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
        <div class="card-body py-3 px-4">
          <div class="row g-3 align-items-center">

            <div class="col-12 col-md-5">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="bi bi-search text-muted" style="font-size:.85rem;"></i>
                </span>
                <input type="text" id="fbSearch" class="form-control border-start-0 ps-0"
                  placeholder="Search feedback text or startup name…" style="font-size:.855rem;"/>
              </div>
            </div>

            <div class="col-6 col-md-3">
              <select id="fbStartup" class="form-select" style="font-size:.845rem;">
                <option value="">All startups</option>
                <% [...new Map(feedback.map(f => [f.startup_id, f])).values()].forEach(f => { %>
                  <option value="<%= f.startup_id %>"><%= f.startup_title %></option>
                <% }); %>
              </select>
            </div>

            <div class="col-6 col-md-4 d-flex align-items-center justify-content-end gap-2">
              <span class="text-muted" id="fbCount" style="font-size:.78rem;white-space:nowrap;"></span>
              <button id="fbReset" class="btn btn-outline-secondary btn-sm" style="font-size:.78rem;display:none;">
                <i class="bi bi-x-lg me-1"></i>Reset
              </button>
            </div>

          </div>
        </div>
      </div>

      <!-- ── Empty state (no feedback at all) ── -->
      <% if (feedback.length === 0) { %>
        <div class="card border-0 shadow-sm text-center py-5 px-4" style="border-radius:14px;">
          <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 mx-auto"
            style="width:72px;height:72px;background:#f5f3ff;">
            <i class="bi bi-chat-square-dots" style="font-size:2rem;color:#7c3aed;"></i>
          </div>
          <h5 class="fw-bold mb-1" style="color:#111;">No feedback given yet</h5>
          <p class="text-muted mb-4" style="font-size:.875rem;max-width:360px;margin:0 auto .75rem;">
            Visit a startup and submit your first feedback to guide the team.
          </p>
          <a href="/mentor/dashboard" class="btn btn-primary fw-semibold px-4">
            <i class="bi bi-arrow-left me-1"></i> Go to Dashboard
          </a>
        </div>

      <% } else { %>

        <!-- ── Feedback list ── -->
        <div class="d-flex flex-column gap-3" id="feedbackList">
          <% feedback.forEach(f => { %>
          <div class="feedback-item card border-0 shadow-sm" style="border-radius:14px;"
            data-text="<%= f.feedback.toLowerCase() %>"
            data-startup="<%= f.startup_title.toLowerCase() %>"
            data-startup-id="<%= f.startup_id %>">

            <!-- Accent bar -->
            <div style="height:3px;border-radius:14px 14px 0 0;background:#7c3aed;"></div>

            <div class="card-body p-4">
              <div class="row g-3 align-items-start">

                <!-- Left: startup info -->
                <div class="col-12 col-md-3 col-lg-2">
                  <div class="d-flex flex-md-column gap-2 gap-md-1">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:40px;height:40px;background:var(--ip-red-pale);font-size:1.1rem;">
                      <%
                        const di = {'EdTech':'📚','HealthTech':'🏥','FinTech':'💳','AgriTech':'🌾','E-Commerce':'🛒','SaaS':'☁️','AI/ML':'🤖','IoT':'📡','Social Impact':'🌍','Other':'🔧'};
                      %><%= di[f.domain] || '🚀' %>
                    </div>
                    <div>
                      <a href="/mentor/startup/<%= f.startup_id %>"
                        class="fw-semibold text-decoration-none d-block"
                        style="font-size:.845rem;color:var(--ip-red);line-height:1.3;">
                        <%= f.startup_title %>
                      </a>
                      <div class="d-flex flex-wrap gap-1 mt-1">
                        <span class="badge badge-<%= f.startup_status %>" style="font-size:.62rem;"><%= f.startup_status %></span>
                        <span class="badge" style="background:#f1f5f9;color:#475569;font-size:.62rem;"><%= f.domain %></span>
                      </div>
                      <div class="mt-1" style="font-size:.72rem;color:#9ca3af;">
                        <i class="bi bi-person me-1"></i><%= f.student_name %>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Divider (visible on md+) -->
                <div class="col-md-auto d-none d-md-flex align-items-stretch">
                  <div style="width:1px;background:#e3e7ef;min-height:60px;"></div>
                </div>

                <!-- Right: feedback content -->
                <div class="col-12 col-md">
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="avatar-circle flex-shrink-0" style="width:28px;height:28px;font-size:.72rem;">
                      <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                    <span class="fw-semibold" style="font-size:.82rem;color:#111;"><%= user.name %></span>
                    <span class="badge ms-1" style="background:#fdf2f2;color:var(--ip-red);font-size:.6rem;">You</span>
                    <span class="text-muted ms-auto" style="font-size:.73rem;white-space:nowrap;">
                      <i class="bi bi-calendar3 me-1"></i>
                      <%= new Date(f.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                      <span class="ms-1 d-none d-sm-inline">
                        · <%= new Date(f.created_at).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %>
                      </span>
                    </span>
                  </div>
                  <p class="mb-0" style="font-size:.875rem;color:#374151;line-height:1.75;"><%= f.feedback %></p>
                  <div class="mt-2 d-flex align-items-center gap-2">
                    <span class="text-muted" style="font-size:.72rem;">
                      <i class="bi bi-type me-1"></i><%= f.feedback.length %> characters
                    </span>
                    <a href="/mentor/startup/<%= f.startup_id %>" class="btn btn-outline-secondary btn-sm ms-auto" style="font-size:.73rem;padding:.2rem .55rem;">
                      View startup <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          </div>
          <% }); %>
        </div>

        <!-- Filter empty state -->
        <div id="fbFilterEmpty" class="text-center py-5 d-none">
          <i class="bi bi-funnel" style="font-size:2.5rem;color:#d1d5db;display:block;margin-bottom:.75rem;"></i>
          <h6 class="fw-bold" style="color:#111;">No feedback matches your filters</h6>
          <p class="text-muted mb-3" style="font-size:.855rem;">Try adjusting or resetting the filters.</p>
          <button class="btn btn-outline-secondary btn-sm" onclick="resetFb()">
            <i class="bi bi-x-lg me-1"></i>Reset filters
          </button>
        </div>

      <% } %>

    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
  const items  = document.querySelectorAll('.feedback-item');
  const search = document.getElementById('fbSearch');
  const sel    = document.getElementById('fbStartup');
  const count  = document.getElementById('fbCount');
  const reset  = document.getElementById('fbReset');
  const empty  = document.getElementById('fbFilterEmpty');

  if (!items.length) return;

  function applyFilter() {
    const q  = search ? search.value.toLowerCase().trim() : '';
    const s  = sel    ? sel.value : '';
    const has = q || s;
    let visible = 0;

    items.forEach(el => {
      const textMatch    = !q || el.dataset.text.includes(q) || el.dataset.startup.includes(q);
      const startupMatch = !s || el.dataset.startupId === s;
      const show = textMatch && startupMatch;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (count) count.textContent = visible + ' result' + (visible !== 1 ? 's' : '');
    if (reset) reset.style.display = has ? '' : 'none';
    if (empty) empty.classList.toggle('d-none', visible > 0);
  }

  if (search) search.addEventListener('input', applyFilter);
  if (sel)    sel.addEventListener('change', applyFilter);
  if (reset)  reset.addEventListener('click', resetFb);

  applyFilter();

  window.resetFb = function() {
    if (search) search.value = '';
    if (sel)    sel.value    = '';
    applyFilter();
  };
})();
</script>
</body>
</html>
