<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/><link rel="stylesheet" href="/css/resources.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>
  <main class="app-main"><div class="container-fluid px-4">
    <div class="page-hero"><h1><i class="bi bi-boxes me-2"></i>Startup Resources</h1><p>Equipment and bookings for the startups you mentor</p></div>
    <%- include('../layouts/flash') %>

    <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;"><div class="card-body p-4">
      <div class="card-section-title"><i class="bi bi-box-arrow-in-right me-1"></i>Currently issued</div>
      <% if (!assignments.length) { %><p class="text-muted mb-0" style="font-size:.85rem;">No equipment currently issued to your startups.</p>
      <% } else { %><table class="table table-sm align-middle mb-0" style="font-size:.85rem;"><thead><tr><th>Resource</th><th>Startup</th><th>Student</th><th>Due</th><th>Status</th></tr></thead><tbody>
        <% assignments.forEach(function(a){ %><tr><td><%= a.resource_name %> <span class="text-muted" style="font-size:.75rem;"><%= a.asset_code %></span></td><td><%= a.startup_title %></td><td><%= a.student_name %></td><td><%= h.date(a.expected_return_at) %></td><td><%- h.badge(a.status) %></td></tr><% }); %>
      </tbody></table><% } %>
    </div></div>

    <div class="card border-0 shadow-sm" style="border-radius:14px;"><div class="card-body p-4">
      <div class="card-section-title"><i class="bi bi-calendar3 me-1"></i>Upcoming bookings</div>
      <% if (!bookings.length) { %><p class="text-muted mb-0" style="font-size:.85rem;">No upcoming bookings for your startups.</p>
      <% } else { %><table class="table table-sm align-middle mb-0" style="font-size:.85rem;"><thead><tr><th>Resource</th><th>Startup</th><th>Date</th><th>Time</th></tr></thead><tbody>
        <% bookings.forEach(function(b){ %><tr><td><%= b.resource_name %></td><td><%= b.startup_title %></td><td><%= h.date(b.booking_date) %></td><td><%= String(b.start_time).slice(0,5) %>–<%= String(b.end_time).slice(0,5) %></td></tr><% }); %>
      </tbody></table><% } %>
    </div></div>
  </div></main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
