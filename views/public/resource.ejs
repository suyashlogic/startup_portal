<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= resource.name %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/resources.css"/>
</head>
<body style="background:#EFEFEB;">
<div class="container" style="max-width:520px;padding-top:3rem;padding-bottom:3rem;">
  <div class="text-center mb-4">
    <span style="font-size:2rem;">🎓</span>
    <div style="font-weight:800;font-size:1.2rem;color:var(--ip-red,#CE4048);">IncuPortal</div>
  </div>

  <div class="card border-0 shadow-sm" style="border-radius:16px;">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <h4 class="fw-bold mb-1"><%= resource.name %></h4>
          <code style="color:#662C11;"><%= resource.asset_code %></code>
        </div>
        <span class="badge rs-<%= String(resource.status).toLowerCase() %>"><%= resource.status.charAt(0) + resource.status.slice(1).toLowerCase().replace(/_/g,' ') %></span>
      </div>

      <table class="table table-sm mb-3" style="font-size:.88rem;">
        <tbody>
          <tr><td class="text-muted" style="width:40%;">Category</td><td class="fw-semibold"><%= resource.category_name %></td></tr>
          <tr><td class="text-muted">Location</td><td class="fw-semibold"><%= resource.location || 'Not specified' %></td></tr>
          <tr><td class="text-muted">Condition</td><td class="fw-semibold"><%= resource.condition.charAt(0) + resource.condition.slice(1).toLowerCase().replace(/_/g,' ') %></td></tr>
        </tbody>
      </table>
      <% if (resource.description) { %><p style="font-size:.85rem;color:#374151;"><%= resource.description %></p><% } %>

      <div class="d-grid gap-2 mt-4">
        <a href="/student/resources" class="btn btn-primary fw-bold"><i class="bi bi-box-seam me-1"></i>Browse or request in IncuPortal</a>
        <a href="/student/report-issue" class="btn btn-outline-secondary"><i class="bi bi-flag me-1"></i>Report a problem with this item</a>
      </div>
    </div>
  </div>
  <p class="text-center text-muted mt-3" style="font-size:.75rem;">Sign in required to request, book, or report an issue.</p>
</div>
</body>
</html>
