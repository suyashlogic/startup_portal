<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Not Found — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body style="background:#EFEFEB;">
<div class="container text-center" style="max-width:420px;padding-top:5rem;">
  <div style="font-size:3rem;">🔍</div>
  <h4 class="fw-bold mt-2">Resource not found</h4>
  <p class="text-muted" style="font-size:.875rem;">"<%= code %>" doesn't match any active resource. The label may be out of date.</p>
  <a href="/student/resources" class="btn btn-primary">Browse resources</a>
</div>
</body>
</html>
