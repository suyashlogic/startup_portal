<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Admin Dashboard — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h1>
          <p>Overview of the incubation portal activity</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-white text-primary fw-semibold px-3 py-2" style="font-size:.8rem;border-radius:20px;">
            <i class="bi bi-circle-fill me-1" style="font-size:.5rem;color:#22c55e;"></i>
            System Live
          </span>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <!-- ── Stat Cards ── -->
      <div class="row g-3 mb-4">

        <div class="col-6 col-md-4 col-xl-2">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:42px;height:42px;background:var(--ip-red-pale);">
                <i class="bi bi-rocket-takeoff text-primary" style="font-size:1.1rem;"></i>
              </div>
              <div>
                <div class="stat-val"><%= stats.startups.total %></div>
                <div class="stat-lbl">Total Startups</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
          <div class="stat-card" style="border-top-color:#d97706;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:42px;height:42px;background:#fef9ec;">
                <i class="bi bi-hourglass-split" style="font-size:1.1rem;color:#d97706;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#d97706;"><%= stats.startups.pending %></div>
                <div class="stat-lbl">Pending</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
          <div class="stat-card" style="border-top-color:#1a7a4a;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:42px;height:42px;background:#f0fdf4;">
                <i class="bi bi-check-circle" style="font-size:1.1rem;color:#1a7a4a;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#1a7a4a;"><%= stats.startups.approved %></div>
                <div class="stat-lbl">Approved</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
          <div class="stat-card" style="border-top-color:#3b82f6;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:42px;height:42px;background:#eff6ff;">
                <i class="bi bi-mortarboard" style="font-size:1.1rem;color:#3b82f6;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#3b82f6;"><%= stats.users.students %></div>
                <div class="stat-lbl">Students</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
          <div class="stat-card" style="border-top-color:#7c3aed;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:42px;height:42px;background:#f5f3ff;">
                <i class="bi bi-person-badge" style="font-size:1.1rem;color:#7c3aed;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#7c3aed;"><%= stats.users.mentors %></div>
                <div class="stat-lbl">Mentors</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
          <div class="stat-card" style="border-top-color:#059669;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:42px;height:42px;background:#ecfdf5;">
                <i class="bi bi-cash-coin" style="font-size:1.1rem;color:#059669;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#059669;font-size:1.4rem;">
                  ₹<%= Math.round(stats.funding.total_approved / 1000) %>K
                </div>
                <div class="stat-lbl">Funded</div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /stats row -->

      <!-- ── Chart + Recent Submissions ── -->
      <div class="row g-4 mb-4">

        <!-- Doughnut chart -->
        <div class="col-lg-4">
          <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-pie-chart me-1"></i>Startup status breakdown</div>
              <div class="d-flex justify-content-center align-items-center" style="height:220px;">
                <canvas id="statusChart"></canvas>
              </div>
              <!-- Legend -->
              <div class="d-flex justify-content-center gap-3 mt-2 flex-wrap">
                <div class="d-flex align-items-center gap-1" style="font-size:.75rem;">
                  <span class="rounded-circle d-inline-block" style="width:10px;height:10px;background:#f59e0b;"></span>
                  Pending (<%= stats.startups.pending %>)
                </div>
                <div class="d-flex align-items-center gap-1" style="font-size:.75rem;">
                  <span class="rounded-circle d-inline-block" style="width:10px;height:10px;background:#10b981;"></span>
                  Approved (<%= stats.startups.approved %>)
                </div>
                <div class="d-flex align-items-center gap-1" style="font-size:.75rem;">
                  <span class="rounded-circle d-inline-block" style="width:10px;height:10px;background:#ef4444;"></span>
                  Rejected (<%= stats.startups.rejected %>)
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent submissions -->
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="card-section-title mb-0"><i class="bi bi-clock-history me-1"></i>Recent submissions</div>
                <a href="/admin/startups" class="btn btn-outline-secondary btn-sm fw-semibold" style="font-size:.78rem;">
                  View all <i class="bi bi-arrow-right ms-1"></i>
                </a>
              </div>

              <% if (recentStartups.length === 0) { %>
                <div class="text-center py-4">
                  <i class="bi bi-inbox" style="font-size:2rem;color:#d1d5db;display:block;margin-bottom:.5rem;"></i>
                  <p class="text-muted mb-0" style="font-size:.845rem;">No startups submitted yet.</p>
                </div>
              <% } else { %>
                <div class="d-flex flex-column gap-0">
                  <% recentStartups.forEach((s, i) => { %>
                    <div class="d-flex align-items-center gap-3 py-3 <%= i < recentStartups.length - 1 ? 'border-bottom' : '' %>"
                      style="border-color:#e3e7ef !important;">
                      <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:38px;height:38px;background:var(--ip-red-pale);font-size:1.1rem;">
                        <%
                          const di = {'EdTech':'📚','HealthTech':'🏥','FinTech':'💳','AgriTech':'🌾','E-Commerce':'🛒','SaaS':'☁️','AI/ML':'🤖','IoT':'📡','Social Impact':'🌍','Other':'🔧'};
                        %><%= di[s.domain] || '🚀' %>
                      </div>
                      <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold text-truncate" style="font-size:.875rem;color:#111;">
                          <a href="/admin/startup/<%= s.id %>" class="text-decoration-none" style="color:inherit;"><%= s.title %></a>
                        </div>
                        <div class="text-muted text-truncate" style="font-size:.75rem;">
                          <i class="bi bi-person me-1"></i><%= s.student_name %> &nbsp;·&nbsp;
                          <i class="bi bi-tag me-1"></i><%= s.domain %>
                        </div>
                      </div>
                      <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <span class="badge badge-<%= s.status %> d-inline-flex align-items-center gap-1">
                          <% if (s.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.6rem;"></i>
                          <% } else if (s.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.6rem;"></i>
                          <% } else { %><i class="bi bi-clock" style="font-size:.6rem;"></i><% } %>
                          <%= s.status %>
                        </span>
                        <a href="/admin/startup/<%= s.id %>" class="btn btn-outline-secondary btn-sm" style="font-size:.72rem;padding:.25rem .55rem;">
                          Review
                        </a>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

      </div><!-- /row -->

      <!-- ── Quick Action Cards ── -->
      <div class="row g-3">

        <div class="col-12 col-md-4">
          <a href="/admin/startups?status=pending" class="text-decoration-none">
            <div class="card border-0 shadow-sm text-center p-4" style="border-radius:14px;transition:transform .2s,box-shadow .2s;border-top:3px solid #d97706 !important;"
              onmouseenter="this.style.transform='translateY(-3px)';this.style.boxShadow='0 10px 24px rgba(217,119,6,.15)'"
              onmouseleave="this.style.transform='';this.style.boxShadow=''">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                style="width:56px;height:56px;background:#fef9ec;">
                <i class="bi bi-hourglass-split" style="font-size:1.5rem;color:#d97706;"></i>
              </div>
              <div class="fw-bold mb-1" style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.85rem;color:#111;text-transform:uppercase;letter-spacing:.06em;">Pending Reviews</div>
              <div style="font-size:2.2rem;font-weight:800;color:#d97706;line-height:1;"><%= stats.startups.pending %></div>
              <div class="text-muted mt-2" style="font-size:.78rem;">startups awaiting decision</div>
            </div>
          </a>
        </div>

        <div class="col-12 col-md-4">
          <a href="/admin/funding" class="text-decoration-none">
            <div class="card border-0 shadow-sm text-center p-4" style="border-radius:14px;transition:transform .2s,box-shadow .2s;border-top:3px solid #059669 !important;"
              onmouseenter="this.style.transform='translateY(-3px)';this.style.boxShadow='0 10px 24px rgba(5,150,105,.15)'"
              onmouseleave="this.style.transform='';this.style.boxShadow=''">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                style="width:56px;height:56px;background:#ecfdf5;">
                <i class="bi bi-cash-coin" style="font-size:1.5rem;color:#059669;"></i>
              </div>
              <div class="fw-bold mb-1" style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.85rem;color:#111;text-transform:uppercase;letter-spacing:.06em;">Funding Requests</div>
              <div style="font-size:2.2rem;font-weight:800;color:#059669;line-height:1;"><%= stats.funding.pending %></div>
              <div class="text-muted mt-2" style="font-size:.78rem;">requests awaiting approval</div>
            </div>
          </a>
        </div>

        <div class="col-12 col-md-4">
          <a href="/admin/users" class="text-decoration-none">
            <div class="card border-0 shadow-sm text-center p-4" style="border-radius:14px;transition:transform .2s,box-shadow .2s;border-top:3px solid var(--ip-red) !important;"
              onmouseenter="this.style.transform='translateY(-3px)';this.style.boxShadow='0 10px 24px rgba(139,26,26,.12)'"
              onmouseleave="this.style.transform='';this.style.boxShadow=''">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                style="width:56px;height:56px;background:var(--ip-red-pale);">
                <i class="bi bi-people text-primary" style="font-size:1.5rem;"></i>
              </div>
              <div class="fw-bold mb-1" style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.85rem;color:#111;text-transform:uppercase;letter-spacing:.06em;">Manage Users</div>
              <div style="font-size:2.2rem;font-weight:800;color:var(--ip-red);line-height:1;">
                <%= parseInt(stats.users.students) + parseInt(stats.users.mentors) %>
              </div>
              <div class="text-muted mt-2" style="font-size:.78rem;">total registered users</div>
            </div>
          </a>
        </div>

      </div><!-- /quick actions -->

    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const ctx = document.getElementById('statusChart').getContext('2d');
new Chart(ctx, {
  type: 'doughnut',
  data: {
    labels: ['Pending', 'Approved', 'Rejected'],
    datasets: [{
      data: [<%= stats.startups.pending %>, <%= stats.startups.approved %>, <%= stats.startups.rejected %>],
      backgroundColor: ['#f59e0b', '#10b981', '#ef4444'],
      borderWidth: 0,
      hoverOffset: 6
    }]
  },
  options: {
    responsive: true,
    cutout: '70%',
    plugins: { legend: { display: false } }
  }
});
</script>
</body>
</html>
