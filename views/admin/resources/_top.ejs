<%# params: title, heading, icon, sub, active, actions (raw html) %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="/css/resources.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../../layouts/sidebar') %>
  <main class="app-main">
    <div class="container-fluid px-4">
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi <%= icon %> me-2"></i><%= heading %></h1>
          <% if (sub) { %><p><%= sub %></p><% } %>
        </div>
        <div class="d-flex gap-2 flex-wrap"><%- actions || '' %></div>
      </div>
      <%- include('../../layouts/flash') %>
      <ul class="nav nav-pills rs-tabs mb-3 gap-1 flex-wrap">
        <% [['overview','Overview','/admin/resources/overview'],['all','All resources','/admin/resources'],['requests','Requests','/admin/resources/requests'],['bookings','Bookings','/admin/resources/bookings'],
            ['assignments','Assignments','/admin/resources/assignments'],['issues','Issues','/admin/resources/issues'],['maintenance','Maintenance','/admin/resources/maintenance'],['categories','Categories','/admin/resources/categories']].forEach(function(t){ %>
          <li class="nav-item"><a class="nav-link <%= active === t[0] ? 'active' : '' %>" href="<%= t[2] %>"><%= t[1] %></a></li>
        <% }); %>
      </ul>
