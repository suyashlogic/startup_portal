<%- include('_top', { title, heading: 'Resource Issues', icon: 'bi-flag', sub: 'Damage, malfunction and loss reports from students', active: 'issues', actions: '' }) %>

<ul class="nav nav-tabs mb-3" style="font-size:.85rem;">
  <% ['OPEN','UNDER_INSPECTION','IN_REPAIR','RESOLVED','CLOSED'].forEach(function(s){ %>
    <li class="nav-item"><a class="nav-link <%= status === s ? 'active' : '' %>" href="/admin/resources/issues?status=<%= s %>"><%= h.label(s) %> <span class="badge bg-light text-dark"><%= counts[s] || 0 %></span></a></li>
  <% }); %>
</ul>

<div class="card border-0 shadow-sm" style="border-radius:14px;"><div class="card-body p-0">
  <% if (!issues.length) { %><div class="text-center py-5 text-muted" style="font-size:.9rem;"><i class="bi bi-flag d-block mb-2" style="font-size:2rem;color:#d1d5db;"></i>No <%= h.label(status).toLowerCase() %> issues.</div>
  <% } else { %>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th class="ps-4">Resource</th><th>Reported by</th><th>Type</th><th>Description</th><th>Photo</th><th>Status</th><th class="text-end pe-4">Actions</th></tr></thead><tbody>
    <% issues.forEach(function(i){ %>
      <tr>
        <td class="ps-4 fw-semibold" style="font-size:.85rem;"><%= i.resource_name %><div class="text-muted fw-normal" style="font-size:.72rem;"><%= i.asset_code %> · <%- h.badge(i.resource_status) %></div></td>
        <td style="font-size:.82rem;"><%= i.reporter_name || 'Admin' %><div class="text-muted" style="font-size:.72rem;"><%= h.date(i.created_at) %></div></td>
        <td><span class="badge" style="background:#f1f5f9;color:#475569;font-size:.7rem;"><%= h.label(i.issue_type) %></span></td>
        <td style="font-size:.8rem;max-width:220px;"><%= i.description %></td>
        <td><% if (i.attachment) { %><a href="<%= i.attachment %>" target="_blank" class="btn btn-outline-secondary btn-sm" style="font-size:.72rem;"><i class="bi bi-image"></i></a><% } else { %><span class="text-muted">—</span><% } %></td>
        <td><%- h.badge(i.status) %></td>
        <td class="text-end pe-4 text-nowrap">
          <% if (i.status === 'OPEN') { %>
            <form action="/admin/resources/issues/<%= i.id %>/inspect" method="POST" class="d-inline"><button class="btn btn-outline-primary btn-sm" style="font-size:.75rem;">Inspect</button></form>
          <% } %>
          <% if (['OPEN','UNDER_INSPECTION'].includes(i.status) && i.quantity === 1 && ['AVAILABLE','DAMAGED'].includes(i.resource_status)) { %>
            <button class="btn btn-primary btn-sm fw-semibold" style="font-size:.75rem;" data-bs-toggle="modal" data-bs-target="#maintModal"
              data-action="/admin/resources/issues/<%= i.id %>/start-maintenance" data-resource="<%= i.resource_id %>" data-name="<%= i.resource_name %>"
              data-desc="<%= i.issue_type %>: <%= i.description.replace(/"/g,'&quot;') %>">Start maintenance</button>
          <% } %>
          <% if (['OPEN','UNDER_INSPECTION'].includes(i.status)) { %>
            <button class="btn btn-outline-secondary btn-sm" style="font-size:.75rem;" data-bs-toggle="modal" data-bs-target="#resolveModal" data-action="/admin/resources/issues/<%= i.id %>/resolve">Resolve</button>
          <% } %>
        </td>
      </tr>
    <% }); %></tbody></table></div>
  <% } %>
</div></div>

<div class="modal fade" id="resolveModal" tabindex="-1"><div class="modal-dialog"><form method="POST" class="modal-content">
  <div class="modal-header"><h6 class="modal-title fw-bold">Resolve issue</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body"><label class="form-label fw-semibold" style="font-size:.85rem;">Resolution <span class="text-danger">*</span></label>
    <textarea name="resolution" class="form-control" rows="3" required placeholder="e.g. Checked — no fault found, USB port working normally."></textarea>
    <div class="form-text" style="font-size:.72rem;">Use this when no repair was needed. If repair is needed, use "Start maintenance" instead.</div></div>
  <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button><button class="btn btn-primary fw-semibold">Resolve</button></div>
</form></div></div>

<div class="modal fade" id="maintModal" tabindex="-1"><div class="modal-dialog"><form method="POST" class="modal-content">
  <input type="hidden" name="resource_id" id="maintResId"/>
  <div class="modal-header"><h6 class="modal-title fw-bold">Start maintenance — <span id="maintName"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <div class="mb-3"><label class="form-label fw-semibold" style="font-size:.85rem;">Type</label>
      <select name="maintenance_type" class="form-select"><% ['REPAIR','PREVENTIVE','CALIBRATION','UPGRADE','OTHER'].forEach(function(t){ %><option value="<%= t %>"><%= h.label(t) %></option><% }); %></select></div>
    <div class="mb-3"><label class="form-label fw-semibold" style="font-size:.85rem;">Description</label><textarea name="description" id="maintDesc" class="form-control" rows="2"></textarea></div>
    <div class="row g-2 mb-3">
      <div class="col-6"><label class="form-label fw-semibold" style="font-size:.85rem;">Start date</label><input type="date" name="start_date" class="form-control"/></div><div class="col-6"><label class="form-label fw-semibold" style="font-size:.85rem;">Vendor / technician</label><input name="vendor" class="form-control" placeholder="Campus workshop"/></div>
      <div class="col-6"><label class="form-label fw-semibold" style="font-size:.85rem;">Expected completion</label><input type="date" name="expected_completion" class="form-control"/></div>
    </div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button><button class="btn btn-primary fw-semibold">Start maintenance</button></div>
</form></div></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('.modal').forEach(function (m) {
  m.addEventListener('show.bs.modal', function (e) {
    var b = e.relatedTarget; if (!b) return;
    m.querySelector('form').action = b.getAttribute('data-action');
    if (m.id === 'maintModal') { document.getElementById('maintResId').value = b.getAttribute('data-resource');
      document.getElementById('maintName').textContent = b.getAttribute('data-name'); document.getElementById('maintDesc').value = b.getAttribute('data-desc') || ''; }
  });
});
</script>
</div></main></div></body></html>
