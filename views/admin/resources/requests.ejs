<%- include('_top', { title, heading: 'Resource Requests', icon: 'bi-inbox', sub: 'Review, approve and issue equipment requests', active: 'requests', actions: '' }) %>

<ul class="nav nav-tabs mb-3" style="font-size:.85rem;">
  <% ['PENDING','APPROVED','ISSUED','COMPLETED','REJECTED','CANCELLED'].forEach(function(s){ %>
    <li class="nav-item"><a class="nav-link <%= status === s ? 'active' : '' %>" href="/admin/resources/requests?status=<%= s %>"><%= h.label(s) %> <span class="badge bg-light text-dark"><%= counts[s] || 0 %></span></a></li>
  <% }); %>
</ul>

<div class="card border-0 shadow-sm" style="border-radius:14px;"><div class="card-body p-0">
  <% if (!requests.length) { %><div class="text-center py-5 text-muted" style="font-size:.9rem;"><i class="bi bi-inbox d-block mb-2" style="font-size:2rem;color:#d1d5db;"></i>No <%= status.toLowerCase() %> requests.</div>
  <% } else { %>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th class="ps-4">Student</th><th>Startup</th><th>Resource</th><th>Purpose</th><th>Needed</th><th>Status</th><th class="text-end pe-4">Actions</th></tr></thead><tbody>
    <% requests.forEach(function(q){ %>
      <tr>
        <td class="ps-4" style="font-size:.85rem;"><%= q.student_name %><div class="text-muted" style="font-size:.72rem;"><%= h.date(q.created_at) %></div></td>
        <td style="font-size:.82rem;"><%= q.startup_title || '—' %></td>
        <td style="font-size:.85rem;" class="fw-semibold"><%= q.resource_name %> <span class="text-muted fw-normal">×<%= q.quantity %></span><div class="text-muted" style="font-size:.72rem;"><%= q.asset_code %></div></td>
        <td style="font-size:.8rem;max-width:220px;"><%= q.purpose %><% if (q.admin_remarks) { %><div class="text-danger" style="font-size:.72rem;"><i class="bi bi-chat-left-quote me-1"></i><%= q.admin_remarks %></div><% } %></td>
        <td style="font-size:.8rem;white-space:nowrap;"><%= h.date(q.requested_from) %> → <%= h.date(q.requested_until) %></td>
        <td><%- h.badge(q.status) %></td>
        <td class="text-end pe-4 text-nowrap">
          <% if (q.status === 'PENDING') { %>
            <form action="/admin/resources/requests/<%= q.id %>/approve" method="POST" class="d-inline" onsubmit="return confirm('Approve this request?');"><button class="btn btn-sm fw-semibold" style="background:#1a7a4a;color:#fff;font-size:.75rem;">Approve</button></form>
            <button class="btn btn-danger btn-sm fw-semibold" style="font-size:.75rem;" data-bs-toggle="modal" data-bs-target="#rejectModal" data-action="/admin/resources/requests/<%= q.id %>/reject">Reject</button>
          <% } %>
          <% if (q.status === 'APPROVED') { %>
            <button class="btn btn-primary btn-sm fw-semibold" style="font-size:.75rem;" data-bs-toggle="modal" data-bs-target="#issueModal"
              data-action="/admin/resources/requests/<%= q.id %>/issue" data-until="<%= new Date(q.requested_until).getFullYear() + '-' + String(new Date(q.requested_until).getMonth()+1).padStart(2,'0') + '-' + String(new Date(q.requested_until).getDate()).padStart(2,'0') %>T17:00" data-name="<%= q.resource_name %>">Issue</button>
          <% } %>
          <% if (q.status === 'PENDING' || q.status === 'APPROVED') { %>
            <form action="/admin/resources/requests/<%= q.id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Cancel this request?');"><button class="btn btn-outline-secondary btn-sm" style="font-size:.75rem;">Cancel</button></form>
          <% } %>
        </td>
      </tr>
    <% }); %></tbody></table></div>
  <% } %>
</div></div>

<div class="modal fade" id="rejectModal" tabindex="-1"><div class="modal-dialog"><form method="POST" class="modal-content">
  <div class="modal-header"><h6 class="modal-title fw-bold">Reject request</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body"><label class="form-label fw-semibold" style="font-size:.85rem;">Reason for rejection <span class="text-danger">*</span></label>
    <textarea name="admin_remarks" class="form-control" rows="3" required placeholder="e.g. Equipment already reserved for another startup."></textarea></div>
  <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button><button class="btn btn-danger fw-semibold">Reject request</button></div>
</form></div></div>

<div class="modal fade" id="issueModal" tabindex="-1"><div class="modal-dialog"><form method="POST" class="modal-content">
  <div class="modal-header"><h6 class="modal-title fw-bold">Issue <span id="issueName"></span></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <div class="mb-3"><label class="form-label fw-semibold" style="font-size:.85rem;">Condition at issue <span class="text-danger">*</span></label>
      <select name="issue_condition" class="form-select" required><% ['NEW','GOOD','FAIR','MINOR_DAMAGE','MAJOR_DAMAGE'].forEach(function(c){ %><option value="<%= c %>" <%= c === 'GOOD' ? 'selected' : '' %>><%= h.label(c) %></option><% }); %></select></div>
    <div class="mb-3"><label class="form-label fw-semibold" style="font-size:.85rem;">Expected return <span class="text-danger">*</span></label><input type="datetime-local" name="expected_return_at" id="issueDue" class="form-control" required/></div>
    <div><label class="form-label fw-semibold" style="font-size:.85rem;">Remarks</label><textarea name="remarks" class="form-control" rows="2" placeholder="e.g. Minor scratches on outer casing."></textarea></div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button><button class="btn btn-primary fw-semibold">Issue resource</button></div>
</form></div></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('.modal').forEach(function (m) {
  m.addEventListener('show.bs.modal', function (e) {
    var b = e.relatedTarget; if (!b) return;
    m.querySelector('form').action = b.getAttribute('data-action');
    if (m.id === 'issueModal') { document.getElementById('issueName').textContent = b.getAttribute('data-name'); document.getElementById('issueDue').value = b.getAttribute('data-until'); }
  });
});
</script>
</div></main></div></body></html>
