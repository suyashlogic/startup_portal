<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Startup Review Meetings — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-calendar3 me-2"></i>Startup Review Meetings</h1>
          <p>Schedule, reschedule and track every startup review meeting</p>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <ul class="nav nav-pills mb-3 gap-1 flex-wrap">
        <% [['upcoming','Upcoming',counts.upcoming],['today','Today',counts.today],['requested','Reschedule requested',counts.requested],
            ['completed','Completed',counts.completed],['cancelled','Cancelled / No-show',counts.cancelled],['all','All',counts.all]].forEach(function(t){ %>
          <li class="nav-item">
            <a class="nav-link <%= view === t[0] ? 'active' : '' %>" style="font-size:.85rem;<%= view === t[0] ? '' : 'color:#4b5563;' %>"
               href="/admin/meetings?view=<%= t[0] %>"><%= t[1] %> <span class="badge bg-light text-dark ms-1"><%= t[2] %></span></a>
          </li>
        <% }); %>
      </ul>

      <div class="card border-0 shadow-sm" style="border-radius:14px;">
        <div class="card-body p-0">
          <% if (meetings.length === 0) { %>
            <div class="text-center py-5 px-4">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:72px;height:72px;background:var(--ip-red-pale);">
                <i class="bi bi-calendar-x text-primary" style="font-size:2rem;"></i>
              </div>
              <h5 class="fw-bold mb-1" style="color:#111;">Nothing here</h5>
              <p class="text-muted mb-0" style="font-size:.875rem;">No meetings in this view yet.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th class="ps-4">Date &amp; time</th>
                    <th>Startup</th>
                    <th>Founder</th>
                    <th>Reviewer</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% meetings.forEach(m => { %>
                  <tr>
                    <td class="ps-4">
                      <div class="fw-semibold" style="font-size:.85rem;color:#111;">
                        <%= new Date(m.meeting_date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                      </div>
                      <div class="text-muted" style="font-size:.78rem;">
                        <%= m.start_time.slice(0,5) %> – <%= m.end_time.slice(0,5) %>
                      </div>
                    </td>
                    <td style="font-size:.85rem;"><%= m.startup_title %></td>
                    <td style="font-size:.85rem;"><%= m.student_name %></td>
                    <td style="font-size:.85rem;"><%= m.reviewer_name || '—' %></td>
                    <td>
                      <span class="badge" style="background:#f1f5f9;color:#475569;font-size:.7rem;">
                        <% if (m.meeting_type === 'IN_PERSON') { %><i class="bi bi-geo-alt me-1"></i>In person
                        <% } else if (m.meeting_type === 'ONLINE') { %><i class="bi bi-camera-video me-1"></i>Online
                        <% } else { %><i class="bi bi-diagram-3 me-1"></i>Hybrid<% } %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-<%= m.status === 'COMPLETED' ? 'approved' : m.status === 'CANCELLED' || m.status === 'NO_SHOW' ? 'rejected' : 'pending' %>">
                        <%= m.status.replace(/_/g,' ') %>
                      </span>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/admin/meetings/<%= m.id %>" class="btn btn-primary btn-sm fw-semibold" style="font-size:.78rem;">
                        <i class="bi bi-eye me-1"></i>Open
                      </a>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="px-4 py-2 d-flex align-items-center justify-content-between" style="border-top:1px solid #e3e7ef;background:#fafbfc;border-radius:0 0 14px 14px;">
              <span class="text-muted" style="font-size:.78rem;"><strong><%= meetings.length %></strong> meeting<%= meetings.length !== 1 ? 's' : '' %> shown</span>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
