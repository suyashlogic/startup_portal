<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Manage Startups — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-rocket-takeoff me-2"></i>Manage Startups</h1>
          <p>Review and approve student startup submissions</p>
        </div>
        <span class="badge bg-white text-primary fw-semibold px-3 py-2" style="font-size:.8rem;border-radius:20px;">
          <i class="bi bi-collection me-1"></i><%= startups.length %> result<%= startups.length !== 1 ? 's' : '' %>
        </span>
      </div>

      <%- include('../layouts/flash') %>

      <!-- ── Filter bar ── -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
        <div class="card-body py-3 px-4">
          <form action="/admin/startups" method="GET">
            <div class="row g-3 align-items-end">

              <div class="col-12 col-md-5">
                <label class="form-label fw-semibold mb-1" style="font-size:.8rem;">Search</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0">
                    <i class="bi bi-search text-muted" style="font-size:.85rem;"></i>
                  </span>
                  <input type="text" name="search" class="form-control border-start-0 ps-0"
                    value="<%= filters.search || '' %>"
                    placeholder="Startup name or student…" style="font-size:.855rem;"/>
                </div>
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label fw-semibold mb-1" style="font-size:.8rem;">Status</label>
                <select name="status" class="form-select" style="font-size:.845rem;">
                  <option value="">All status</option>
                  <option value="pending"  <%= filters.status === 'pending'  ? 'selected' : '' %>>Pending</option>
                  <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                  <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                </select>
              </div>

              <div class="col-6 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold flex-grow-1" style="font-size:.855rem;">
                  <i class="bi bi-search me-1"></i> Search
                </button>
                <a href="/admin/startups" class="btn btn-outline-secondary" style="font-size:.855rem;">
                  <i class="bi bi-x-lg"></i>
                </a>
              </div>

            </div>
          </form>
        </div>
      </div>

      <!-- ── Table card ── -->
      <div class="card border-0 shadow-sm" style="border-radius:14px;">
        <div class="card-body p-0">

          <% if (startups.length === 0) { %>
            <div class="text-center py-5 px-4">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                style="width:72px;height:72px;background:var(--ip-red-pale);">
                <i class="bi bi-search text-primary" style="font-size:2rem;"></i>
              </div>
              <h5 class="fw-bold mb-1" style="color:#111;">No startups found</h5>
              <p class="text-muted mb-3" style="font-size:.875rem;">No submissions match your current filters.</p>
              <a href="/admin/startups" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-lg me-1"></i>Clear filters
              </a>
            </div>

          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th class="ps-4" style="width:30%;">Startup</th>
                    <th>Student</th>
                    <th>Domain</th>
                    <th>Stage</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end pe-4">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% startups.forEach(s => { %>
                  <tr>
                    <td class="ps-4">
                      <div class="d-flex align-items-center gap-2">
                        <div class="rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                          style="width:34px;height:34px;background:var(--ip-red-pale);font-size:.95rem;">
                          <%
                            const di = {'EdTech':'📚','HealthTech':'🏥','FinTech':'💳','AgriTech':'🌾','E-Commerce':'🛒','SaaS':'☁️','AI/ML':'🤖','IoT':'📡','Social Impact':'🌍','Other':'🔧'};
                          %><%= di[s.domain] || '🚀' %>
                        </div>
                        <div>
                          <div class="fw-semibold" style="font-size:.875rem;color:#111;"><%= s.title %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div class="avatar-circle flex-shrink-0" style="width:28px;height:28px;font-size:.72rem;">
                          <%= s.student_name.charAt(0).toUpperCase() %>
                        </div>
                        <span style="font-size:.845rem;"><%= s.student_name %></span>
                      </div>
                    </td>
                    <td><span style="font-size:.83rem;color:#374151;"><%= s.domain %></span></td>
                    <td><span class="badge badge-<%= s.stage %>"><%= s.stage %></span></td>
                    <td>
                      <span class="badge badge-<%= s.status %> d-inline-flex align-items-center gap-1">
                        <% if (s.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.6rem;"></i>
                        <% } else if (s.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.6rem;"></i>
                        <% } else { %><i class="bi bi-clock" style="font-size:.6rem;"></i><% } %>
                        <%= s.status %>
                      </span>
                    </td>
                    <td>
                      <span class="text-muted" style="font-size:.8rem;">
                        <i class="bi bi-calendar3 me-1" style="font-size:.72rem;"></i>
                        <%= new Date(s.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                      </span>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/admin/startup/<%= s.id %>"
                        class="btn btn-primary btn-sm fw-semibold" style="font-size:.78rem;">
                        <i class="bi bi-eye me-1"></i>Review
                      </a>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <div class="px-4 py-2 d-flex align-items-center justify-content-between"
              style="border-top:1px solid #e3e7ef;background:#fafbfc;border-radius:0 0 14px 14px;">
              <span class="text-muted" style="font-size:.78rem;">
                Showing <strong><%= startups.length %></strong> startup<%= startups.length !== 1 ? 's' : '' %>
              </span>
              <span class="text-muted" style="font-size:.78rem;">
                <i class="bi bi-info-circle me-1"></i>Click "Review" to approve, reject or assign a mentor
              </span>
            </div>
          <% } %>

        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
