<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Notifications — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>
  <main class="app-main">
    <div class="container-fluid px-4">
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-bell me-2"></i>Notifications</h1>
          <p>Everything that's happened on your startups, funding and account</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/notifications/preferences" class="btn"><i class="bi bi-sliders me-1"></i> Email preferences</a>
          <form action="/notifications/read-all" method="POST" class="d-inline">
            <button type="submit" class="btn btn-white fw-bold"><i class="bi bi-check2-all me-1"></i> Mark all read</button>
          </form>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <ul class="nav nav-pills mb-3 gap-1">
        <li class="nav-item"><a class="nav-link <%= unreadOnly ? '' : 'active' %>" style="font-size:.85rem;<%= unreadOnly ? 'color:#4b5563;' : '' %>" href="/notifications">All</a></li>
        <li class="nav-item"><a class="nav-link <%= unreadOnly ? 'active' : '' %>" style="font-size:.85rem;<%= unreadOnly ? '' : 'color:#4b5563;' %>" href="/notifications?filter=unread">Unread <% if (unreadCount > 0) { %><span class="badge bg-light text-dark ms-1"><%= unreadCount %></span><% } %></a></li>
      </ul>

      <div class="card border-0 shadow-sm" style="border-radius:14px;">
        <div class="card-body p-0">
          <% if (items.length === 0) { %>
            <div class="text-center py-5 px-4">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:72px;height:72px;background:var(--ip-red-pale);">
                <i class="bi bi-bell-slash text-primary" style="font-size:2rem;"></i>
              </div>
              <h5 class="fw-bold mb-1" style="color:#111;"><%= unreadOnly ? 'No unread notifications' : 'Nothing here yet' %></h5>
              <p class="text-muted mb-0" style="font-size:.875rem;">Updates about your startups will show up here.</p>
            </div>
          <% } else {
               const icons = {
                 WELCOME:'bi-stars', STARTUP_SUBMITTED:'bi-rocket-takeoff', STARTUP_APPROVED:'bi-check-circle-fill', STARTUP_REJECTED:'bi-info-circle-fill',
                 MENTOR_ASSIGNED:'bi-person-plus-fill', MENTOR_REMOVED:'bi-person-dash-fill', FUNDING_SUBMITTED:'bi-cash-coin',
                 FUNDING_APPROVED:'bi-check-circle-fill', FUNDING_REJECTED:'bi-info-circle-fill', MENTOR_FEEDBACK:'bi-chat-square-text-fill',
                 PROGRESS_UPDATE:'bi-graph-up', ROLE_CHANGED:'bi-shield-check', PASSWORD_CHANGED:'bi-key-fill'
               };
               const tones = { STARTUP_APPROVED:'#1a7a4a', FUNDING_APPROVED:'#1a7a4a', STARTUP_REJECTED:'#c0392b', FUNDING_REJECTED:'#c0392b', PASSWORD_CHANGED:'#d97706', ROLE_CHANGED:'#7c3aed' }; %>
            <% items.forEach(function(n, i){ const c = tones[n.type] || 'var(--ip-red)'; %>
              <div class="d-flex align-items-start gap-3 px-4 py-3" style="<%= i < items.length - 1 ? 'border-bottom:1px solid #e3e7ef;' : '' %><%= n.is_read ? '' : 'background:var(--ip-red-pale);' %>">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:38px;height:38px;background:#fff;border:1px solid #e3e7ef;">
                  <i class="bi <%= icons[n.type] || 'bi-bell' %>" style="color:<%= c %>;"></i>
                </div>
                <div class="flex-grow-1 min-w-0">
                  <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold" style="font-size:.9rem;color:#111;"><%= n.title %></span>
                    <% if (!n.is_read) { %><span class="badge" style="background:var(--ip-red);font-size:.6rem;">New</span><% } %>
                  </div>
                  <div style="font-size:.85rem;color:#4b5563;"><%= n.message %></div>
                  <div class="text-muted mt-1" style="font-size:.72rem;"><i class="bi bi-clock me-1"></i><%= new Date(n.created_at).toLocaleString('en-IN',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
                </div>
                <form action="/notifications/<%= n.id %>/read" method="POST" class="flex-shrink-0">
                  <% if (n.link) { %>
                    <button type="submit" class="btn btn-outline-primary btn-sm fw-semibold" style="font-size:.75rem;">Open <i class="bi bi-arrow-right ms-1"></i></button>
                  <% } else if (!n.is_read) { %>
                    <button type="submit" class="btn btn-outline-secondary btn-sm" style="font-size:.75rem;">Mark read</button>
                  <% } %>
                </form>
              </div>
            <% }); %>

            <% if (pages > 1) { %>
              <div class="px-4 py-2 d-flex align-items-center justify-content-between" style="border-top:1px solid #e3e7ef;background:#fafbfc;border-radius:0 0 14px 14px;">
                <span class="text-muted" style="font-size:.78rem;">Page <strong><%= page %></strong> of <%= pages %> · <%= total %> total</span>
                <div class="d-flex gap-2">
                  <a class="btn btn-outline-secondary btn-sm <%= page <= 1 ? 'disabled' : '' %>" href="/notifications?page=<%= page - 1 %><%= unreadOnly ? '&filter=unread' : '' %>">Previous</a>
                  <a class="btn btn-outline-secondary btn-sm <%= page >= pages ? 'disabled' : '' %>" href="/notifications?page=<%= page + 1 %><%= unreadOnly ? '&filter=unread' : '' %>">Next</a>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
