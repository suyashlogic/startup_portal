<nav class="flex-grow-1 pt-2">
  <div class="sidebar-section">Navigation</div>

  <% if (user.role === 'student') { %>
    <a href="/student/dashboard"
       class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/student/dashboard' ? 'active' : '' %>">
      <i class="bi bi-house-door s-icon"></i> Dashboard
    </a>
    <a href="/student/startup/new"
       class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/student/startup/new' ? 'active' : '' %>">
      <i class="bi bi-lightbulb s-icon"></i> Submit Idea
    </a>
    <a href="/student/startups" class="sidebar-link">
      <i class="bi bi-rocket s-icon"></i> My Startups
    </a>
    <div class="sidebar-section mt-2">Resources</div>
    <a href="/student/resources" class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/student/resources' ? 'active' : '' %>">
      <i class="bi bi-boxes s-icon"></i> Browse Resources
    </a>
    <a href="/student/my-resources" class="sidebar-link">
      <i class="bi bi-person-check s-icon"></i> My Resources
    </a>
    <a href="/student/my-bookings" class="sidebar-link">
      <i class="bi bi-calendar-week s-icon"></i> My Bookings
    </a>
    <a href="/student/report-issue" class="sidebar-link">
      <i class="bi bi-flag s-icon"></i> Report Issue
    </a>
    <div class="sidebar-section mt-2">Account</div>
    <a href="/notifications" class="sidebar-link">
      <i class="bi bi-bell s-icon"></i> Notifications
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="badge rounded-pill ms-auto" style="background:#CE4048;color:#fff;font-size:.65rem;"><%= unreadCount %></span><% } %>
    </a>

  <% } else if (user.role === 'admin') { %>
    <a href="/admin/dashboard" class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/admin/dashboard' ? 'active' : '' %>">
      <i class="bi bi-house-door s-icon"></i> Dashboard
    </a>
    <div class="sidebar-section mt-2">Management</div>
    <a href="/admin/startups" class="sidebar-link">
      <i class="bi bi-rocket-takeoff s-icon"></i> Startups
    </a>
    <a href="/admin/funding" class="sidebar-link">
      <i class="bi bi-cash-coin s-icon"></i> Funding
    </a>
    <a href="/admin/users" class="sidebar-link">
      <i class="bi bi-people s-icon"></i> Users
    </a>
    <a href="/admin/email-logs" class="sidebar-link">
      <i class="bi bi-envelope-check s-icon"></i> Email Activity
    </a>
    <div class="sidebar-section mt-2">Resource Management</div>
    <a href="/admin/resources/overview" class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/admin/resources/overview' ? 'active' : '' %>">
      <i class="bi bi-boxes s-icon"></i> Overview
    </a>
    <a href="/admin/resources" class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/admin/resources' ? 'active' : '' %>">
      <i class="bi bi-collection s-icon"></i> All Resources
    </a>
    <a href="/admin/resources/requests" class="sidebar-link">
      <i class="bi bi-inbox s-icon"></i> Requests
    </a>
    <a href="/admin/resources/bookings" class="sidebar-link">
