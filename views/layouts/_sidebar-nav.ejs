    </a>
    <a href="/admin/resources/assignments" class="sidebar-link">
      <i class="bi bi-person-check s-icon"></i> Assignments
    </a>
    <a href="/admin/resources/issues" class="sidebar-link">
      <i class="bi bi-flag s-icon"></i> Issues
    </a>
    <a href="/admin/resources/maintenance" class="sidebar-link">
      <i class="bi bi-tools s-icon"></i> Maintenance
    </a>
    <a href="/admin/resources/categories" class="sidebar-link">
      <i class="bi bi-tags s-icon"></i> Categories
    </a>
    <div class="sidebar-section mt-2">Account</div>
    <a href="/notifications" class="sidebar-link">
      <i class="bi bi-bell s-icon"></i> Notifications
      <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %><span class="badge rounded-pill ms-auto" style="background:#CE4048;color:#fff;font-size:.65rem;"><%= unreadCount %></span><% } %>
    </a>

  <% } else if (user.role === 'mentor') { %>
    <a href="/mentor/dashboard" class="sidebar-link <%= typeof currentPath !== 'undefined' && currentPath === '/mentor/dashboard' ? 'active' : '' %>">
      <i class="bi bi-house-door s-icon"></i> Dashboard
    </a>
    <a href="/mentor/feedback" class="sidebar-link">
      <i class="bi bi-chat-square-text s-icon"></i> Feedback
    </a>
    <a href="/mentor/resources" class="sidebar-link">
      <i class="bi bi-boxes s-icon"></i> Startup Resources
    </a>
    <a href="/notifications" class="sidebar-link">
