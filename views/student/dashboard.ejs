<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-house-door me-2"></i>My Dashboard</h1>
          <p>Welcome back, <strong style="color:rgba(255,255,255,.95);"><%= user.name %></strong>! Track your startup journey here.</p>
        </div>
        <a href="/student/startup/new" class="btn btn-white fw-bold">
          <i class="bi bi-plus-lg me-1"></i> Submit New Idea
        </a>
      </div>

      <%- include('../layouts/flash') %>

      <!-- ── Stat Cards ── -->
      <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:var(--ip-red-pale);">
                <i class="bi bi-rocket-takeoff text-primary" style="font-size:1.2rem;"></i>
              </div>
              <div>
                <div class="stat-val"><%= stats.total %></div>
                <div class="stat-lbl">Total Startups</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#f59e0b;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#fef9ec;">
                <i class="bi bi-hourglass-split" style="font-size:1.2rem;color:#d97706;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#d97706;"><%= stats.pending %></div>
                <div class="stat-lbl">Under Review</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#1a7a4a;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#f0fdf4;">
                <i class="bi bi-check-circle" style="font-size:1.2rem;color:#1a7a4a;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#1a7a4a;"><%= stats.approved %></div>
                <div class="stat-lbl">Approved</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-6 col-md-3">
          <div class="stat-card" style="border-top-color:#c0392b;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                style="width:44px;height:44px;background:#fee2e2;">
                <i class="bi bi-x-circle" style="font-size:1.2rem;color:#c0392b;"></i>
              </div>
              <div>
                <div class="stat-val" style="color:#c0392b;"><%= stats.rejected %></div>
                <div class="stat-lbl">Rejected</div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /stats row -->

      <!-- ── Startup List Card ── -->
      <div class="card border-0 shadow-sm" style="border-radius:14px;">
        <div class="card-body p-0">

          <!-- Card header -->
          <div class="d-flex align-items-center justify-content-between px-4 py-3"
            style="border-bottom:1px solid #e3e7ef;">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-collection text-primary" style="font-size:1rem;"></i>
              <span class="fw-bold" style="font-size:.9rem;color:#111;">My Startup Ideas</span>
              <% if (startups.length > 0) { %>
                <span class="badge bg-primary rounded-pill ms-1" style="font-size:.68rem;"><%= startups.length %></span>
              <% } %>
            </div>
            <a href="/student/startup/new" class="btn btn-outline-primary btn-sm fw-semibold">
              <i class="bi bi-plus-lg me-1"></i> New Idea
            </a>
          </div>

          <!-- Empty state -->
          <% if (startups.length === 0) { %>
            <div class="text-center py-5 px-4">
              <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                style="width:72px;height:72px;background:var(--ip-red-pale);">
                <i class="bi bi-lightbulb text-primary" style="font-size:2rem;"></i>
              </div>
              <h5 class="fw-bold mb-1" style="color:#111;">No ideas submitted yet</h5>
              <p class="text-muted mb-4" style="font-size:.875rem;max-width:340px;margin:0 auto .75rem;">
                Click "Submit New Idea" to get started with your startup journey.
              </p>
              <a href="/student/startup/new" class="btn btn-primary fw-semibold px-4">
                <i class="bi bi-plus-lg me-1"></i> Submit Your First Idea
              </a>
            </div>

          <% } else { %>
            <!-- Table -->
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead>
                  <tr>
                    <th class="ps-4" style="width:30%;">Startup name</th>
                    <th>Domain</th>
                    <th>Stage</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end pe-4">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% startups.forEach(s => { %>
                  <tr>
                    <td class="ps-4">
                      <div class="d-flex align-items-center gap-2">
                        <div class="rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                          style="width:34px;height:34px;background:var(--ip-red-pale);">
                          <i class="bi bi-rocket text-primary" style="font-size:.8rem;"></i>
                        </div>
                        <div>
                          <div class="fw-semibold" style="font-size:.875rem;color:#111;"><%= s.title %></div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span style="font-size:.83rem;color:#374151;"><%= s.domain %></span>
                    </td>
                    <td>
                      <span class="badge badge-<%= s.stage %>"><%= s.stage %></span>
                    </td>
                    <td>
                      <span class="badge badge-<%= s.status %> d-inline-flex align-items-center gap-1">
                        <% if (s.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.65rem;"></i>
                        <% } else if (s.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.65rem;"></i>
                        <% } else { %><i class="bi bi-clock" style="font-size:.65rem;"></i><% } %>
                        <%= s.status %>
                      </span>
                    </td>
                    <td>
                      <span class="text-muted" style="font-size:.82rem;">
                        <i class="bi bi-calendar3 me-1" style="font-size:.75rem;"></i>
                        <%= new Date(s.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
                      </span>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/student/startup/<%= s.id %>" class="btn btn-outline-secondary btn-sm fw-semibold" style="font-size:.78rem;">
                        View <i class="bi bi-arrow-right ms-1"></i>
                      </a>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <!-- Table footer -->
            <div class="px-4 py-2 d-flex align-items-center justify-content-between"
              style="border-top:1px solid #e3e7ef;background:#fafbfc;border-radius:0 0 14px 14px;">
              <span class="text-muted" style="font-size:.78rem;">
                Showing <strong><%= startups.length %></strong> idea<%= startups.length !== 1 ? 's' : '' %>
              </span>
              <span class="text-muted" style="font-size:.78rem;">
                <i class="bi bi-info-circle me-1"></i>Click "View" to see full details &amp; submit progress updates
              </span>
            </div>
          <% } %>

        </div>
      </div><!-- /card -->

    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
