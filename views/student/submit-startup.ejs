<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- Page hero -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-lightbulb me-2"></i>Submit Startup Idea</h1>
          <p>Share your innovation with the incubation cell</p>
        </div>
        <a href="/student/dashboard" class="btn">
          <i class="bi bi-arrow-left me-1"></i> Back
        </a>
      </div>

      <%- include('../layouts/flash') %>

      <div class="row g-4 align-items-start">

        <!-- ── Form column ── -->
        <div class="col-lg-8">

          <!-- Info alert -->
          <div class="alert alert-warning d-flex align-items-start gap-2 border-0 rounded-3 mb-4 py-3" style="background:#fef9ec;border-left:4px solid #f59e0b !important;border-radius:0 8px 8px 0 !important;">
            <i class="bi bi-info-circle-fill text-warning mt-1 flex-shrink-0"></i>
            <div style="font-size:.845rem;">
              <strong>Tips for a strong submission:</strong> Be specific about the problem, target audience, and what makes your idea unique. Attach a pitch deck to significantly improve your approval chances.
            </div>
          </div>

          <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">

              <form action="/student/startup/new" method="POST" enctype="multipart/form-data">

                <!-- Startup Name -->
                <div class="mb-4">
                  <label class="form-label fw-semibold" for="title" style="font-size:.875rem;">
                    Startup name <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                      <i class="bi bi-rocket text-primary" style="font-size:.85rem;"></i>
                    </span>
                    <input type="text" id="title" name="title"
                      class="form-control border-start-0 ps-0"
                      placeholder="e.g. EduTrack AI, FarmConnect, MedBot" required/>
                  </div>
                  <div class="form-text" style="font-size:.75rem;">Choose a clear, memorable name for your startup.</div>
                </div>

                <!-- Description -->
                <div class="mb-4">
                  <label class="form-label fw-semibold" for="description" style="font-size:.875rem;">
                    Describe your idea <span class="text-danger">*</span>
                  </label>
                  <textarea id="description" name="description" class="form-control" rows="5"
                    placeholder="What problem does it solve? Who is the target audience? What makes it unique?"
                    required></textarea>
                  <div class="d-flex justify-content-between mt-1">
                    <div class="form-text" style="font-size:.75rem;">Aim for at least 100 words.</div>
                    <div class="form-text" style="font-size:.75rem;" id="charCount">0 characters</div>
                  </div>
                </div>

                <!-- Domain + Stage row -->
                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold" for="domain" style="font-size:.875rem;">
                      Domain / Industry <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-tag text-secondary" style="font-size:.85rem;"></i>
                      </span>
                      <select id="domain" name="domain" class="form-select border-start-0" required>
                        <option value="">-- Select domain --</option>
                        <option value="EdTech">📚 EdTech</option>
                        <option value="HealthTech">🏥 HealthTech</option>
                        <option value="FinTech">💳 FinTech</option>
                        <option value="AgriTech">🌾 AgriTech</option>
                        <option value="E-Commerce">🛒 E-Commerce</option>
                        <option value="SaaS">☁️ SaaS</option>
                        <option value="AI/ML">🤖 AI / ML</option>
                        <option value="IoT">📡 IoT</option>
                        <option value="Social Impact">🌍 Social Impact</option>
                        <option value="Other">🔧 Other</option>
                      </select>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-semibold" for="stage" style="font-size:.875rem;">
                      Current stage <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-flag text-secondary" style="font-size:.85rem;"></i>
                      </span>
                      <select id="stage" name="stage" class="form-select border-start-0" required>
                        <option value="">-- Select stage --</option>
                        <option value="idea">💡 Idea</option>
                        <option value="prototype">🔧 Prototype</option>
                        <option value="mvp">🚀 MVP</option>
                        <option value="scaling">📈 Scaling</option>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- File upload -->
                <div class="mb-4">
                  <label class="form-label fw-semibold" style="font-size:.875rem;">
                    Pitch deck <span class="text-muted fw-normal">(optional)</span>
                  </label>
                  <div class="upload-zone" id="uploadZone" onclick="document.getElementById('pitch_deck').click()">
                    <i class="bi bi-cloud-arrow-up" style="font-size:2rem;color:#9ca3af;display:block;margin-bottom:.5rem;"></i>
                    <div class="fw-semibold" style="font-size:.875rem;color:#374151;">Drag &amp; drop or click to upload</div>
                    <div style="font-size:.75rem;color:#9ca3af;margin-top:.25rem;">PDF, PPT, DOC — max 10 MB</div>
                    <div id="fileName" class="mt-2 badge bg-success d-none"></div>
                    <input type="file" id="pitch_deck" name="pitch_deck"
                      accept=".pdf,.ppt,.pptx,.doc,.docx" style="display:none;"/>
                  </div>
                </div>

                <!-- Actions -->
                <div class="d-flex align-items-center gap-3 pt-3 border-top">
                  <button type="submit" class="btn btn-primary px-4 py-2 fw-bold" style="font-size:.9rem;letter-spacing:.02em;">
                    <i class="bi bi-rocket-takeoff me-2"></i>Submit Idea
                  </button>
                  <a href="/student/dashboard" class="btn btn-outline-secondary">Cancel</a>
                  <small class="text-muted ms-auto" style="font-size:.75rem;"><span class="text-danger">*</span> Required</small>
                </div>

              </form>
            </div>
          </div>
        </div><!-- /col-lg-8 -->

        <!-- ── Tips sidebar ── -->
        <div class="col-lg-4 d-none d-lg-block">
          <div class="card border-0 shadow-sm sticky-top" style="border-radius:14px;top:calc(56px + 1.5rem);">
            <div class="card-body p-4">

              <div class="card-section-title"><i class="bi bi-info-circle me-1"></i>Submission guide</div>

              <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex gap-3 align-items-start">
                  <div class="rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center"
                    style="width:36px;height:36px;background:var(--ip-red-pale,#fdf2f2);color:var(--ip-red,#8b1a1a);">
                    <i class="bi bi-bullseye" style="font-size:.85rem;"></i>
                  </div>
                  <div>
                    <div class="fw-semibold" style="font-size:.83rem;">Be specific</div>
                    <div style="font-size:.77rem;color:#6b7280;">Clearly define the problem and target market.</div>
                  </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                  <div class="rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center"
                    style="width:36px;height:36px;background:var(--ip-red-pale,#fdf2f2);color:var(--ip-red,#8b1a1a);">
                    <i class="bi bi-file-earmark-slides" style="font-size:.85rem;"></i>
                  </div>
                  <div>
                    <div class="fw-semibold" style="font-size:.83rem;">Add a pitch deck</div>
                    <div style="font-size:.77rem;color:#6b7280;">A slide deck significantly improves approval chances.</div>
                  </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                  <div class="rounded-circle flex-shrink-0 d-flex align-items-center justify-content-center"
                    style="width:36px;height:36px;background:var(--ip-red-pale,#fdf2f2);color:var(--ip-red,#8b1a1a);">
                    <i class="bi bi-graph-up" style="font-size:.85rem;"></i>
                  </div>
                  <div>
                    <div class="fw-semibold" style="font-size:.83rem;">Choose the right stage</div>
                    <div style="font-size:.77rem;color:#6b7280;">Honest staging helps mentors give the right guidance.</div>
                  </div>
                </div>
              </div>

              <hr class="my-3"/>

              <div class="card-section-title"><i class="bi bi-layers me-1"></i>Stage definitions</div>
              <div class="d-flex flex-column gap-2">
                <div class="d-flex align-items-start gap-2" style="font-size:.78rem;">
                  <span class="badge badge-idea mt-1" style="min-width:68px;text-align:center;">Idea</span>
                  <span style="color:#6b7280;">Just a concept, no work done yet</span>
                </div>
                <div class="d-flex align-items-start gap-2" style="font-size:.78rem;">
                  <span class="badge badge-prototype mt-1" style="min-width:68px;text-align:center;">Prototype</span>
                  <span style="color:#6b7280;">Basic version built &amp; tested</span>
                </div>
                <div class="d-flex align-items-start gap-2" style="font-size:.78rem;">
                  <span class="badge badge-mvp mt-1" style="min-width:68px;text-align:center;">MVP</span>
                  <span style="color:#6b7280;">Min. viable product launched</span>
                </div>
                <div class="d-flex align-items-start gap-2" style="font-size:.78rem;">
                  <span class="badge badge-scaling mt-1" style="min-width:68px;text-align:center;">Scaling</span>
                  <span style="color:#6b7280;">Growing user base / revenue</span>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div><!-- /row -->
    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Character counter
const ta=document.getElementById('description'),cc=document.getElementById('charCount');
if(ta&&cc){ta.addEventListener('input',()=>{cc.textContent=ta.value.length+' characters';});}

// File upload feedback
const fi=document.getElementById('pitch_deck'),fn=document.getElementById('fileName'),uz=document.getElementById('uploadZone');
if(fi){
  fi.addEventListener('change',()=>{
    if(fi.files[0]){fn.textContent='📎 '+fi.files[0].name;fn.classList.remove('d-none');}
  });
  uz.addEventListener('dragover',e=>{e.preventDefault();uz.classList.add('dragover');});
  uz.addEventListener('dragleave',()=>uz.classList.remove('dragover'));
  uz.addEventListener('drop',e=>{
    e.preventDefault(); uz.classList.remove('dragover');
    if(e.dataTransfer.files[0]){
      fi.files=e.dataTransfer.files;
      fn.textContent='📎 '+e.dataTransfer.files[0].name; fn.classList.remove('d-none');
    }
  });
}
</script>
</body>
</html>
