<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>My Startup Meetings — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-calendar3 me-2"></i>My Startup Meetings</h1>
          <p>Review meetings for your submitted startups</p>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <ul class="nav nav-pills mb-3 gap-1">
        <li class="nav-item"><a class="nav-link <%= view === 'upcoming' ? 'active' : '' %>" style="font-size:.85rem;<%= view === 'upcoming' ? '' : 'color:#4b5563;' %>" href="/student/meetings">Upcoming</a></li>
        <li class="nav-item"><a class="nav-link <%= view === 'past' ? 'active' : '' %>" style="font-size:.85rem;<%= view === 'past' ? '' : 'color:#4b5563;' %>" href="/student/meetings?view=past">Past</a></li>
      </ul>

      <% if (meetings.length === 0) { %>
        <div class="card border-0 shadow-sm text-center py-5 px-4" style="border-radius:14px;">
          <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 mx-auto" style="width:72px;height:72px;background:var(--ip-red-pale);">
            <i class="bi bi-calendar-x text-primary" style="font-size:2rem;"></i>
          </div>
          <h5 class="fw-bold mb-1" style="color:#111;">No <%= view %> meetings</h5>
          <p class="text-muted mb-0" style="font-size:.875rem;">You'll see a review meeting here once the incubation cell schedules one.</p>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% meetings.forEach(m => { %>
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;">
              <div style="height:4px;border-radius:14px 14px 0 0;background:<%= m.status === 'COMPLETED' ? '#1a7a4a' : ['CANCELLED','NO_SHOW'].includes(m.status) ? '#c0392b' : '#d97706' %>;"></div>
              <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h6 class="fw-bold mb-0" style="font-size:.95rem;color:#111;"><%= m.startup_title %></h6>
                  <span class="badge badge-<%= m.status === 'COMPLETED' ? 'approved' : ['CANCELLED','NO_SHOW'].includes(m.status) ? 'rejected' : 'pending' %>"><%= m.status.replace(/_/g,' ') %></span>
                </div>
                <div style="font-size:.82rem;color:#374151;">
                  <i class="bi bi-calendar3 me-1"></i><%= new Date(m.meeting_date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %><br>
                  <i class="bi bi-clock me-1"></i><%= m.start_time.slice(0,5) %> – <%= m.end_time.slice(0,5) %><br>
                  <% if (m.meeting_type === 'ONLINE') { %><i class="bi bi-camera-video me-1"></i>Online<% } else { %><i class="bi bi-geo-alt me-1"></i><%= m.location %><% } %>
                </div>
                <a href="/student/meetings/<%= m.id %>" class="btn btn-outline-primary btn-sm fw-semibold mt-3">View details <i class="bi bi-arrow-right ms-1"></i></a>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      <% } %>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
