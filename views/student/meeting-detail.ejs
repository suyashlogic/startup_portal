<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= title %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <div class="page-hero">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
          <div>
            <h1 class="mb-2"><i class="bi bi-calendar3 me-2"></i><%= meeting.startup_title %></h1>
            <span class="badge badge-<%= meeting.status === 'COMPLETED' ? 'approved' : ['CANCELLED','NO_SHOW'].includes(meeting.status) ? 'rejected' : 'pending' %>"><%= meeting.status.replace(/_/g,' ') %></span>
          </div>
          <a href="/student/meetings" class="btn align-self-start"><i class="bi bi-arrow-left me-1"></i> Back</a>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <% if (meeting.pendingRequest) { %>
        <div class="alert d-flex align-items-start gap-3 border-0 rounded-3 mb-4 py-3" style="background:#fef9ec;border-left:4px solid #f59e0b !important;border-radius:0 10px 10px 0 !important;">
          <i class="bi bi-hourglass-split flex-shrink-0 mt-1" style="color:#d97706;"></i>
          <div style="font-size:.875rem;">Your reschedule request is pending review by the incubation cell.</div>
        </div>
      <% } %>

      <div class="row g-4 align-items-start">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-info-circle me-1"></i>Meeting details</div>
              <table class="table table-sm mb-3" style="font-size:.87rem;">
                <tbody>
                  <tr><td class="text-muted" style="width:36%;">Date</td><td class="fw-semibold"><%= new Date(meeting.meeting_date).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></td></tr>
                  <tr><td class="text-muted">Time</td><td class="fw-semibold"><%= meeting.start_time.slice(0,5) %> – <%= meeting.end_time.slice(0,5) %> (IST)</td></tr>
                  <tr><td class="text-muted">Type</td><td class="fw-semibold"><%= meeting.meeting_type.replace('_',' ') %></td></tr>
                  <% if (meeting.location) { %><tr><td class="text-muted">Location</td><td class="fw-semibold"><%= meeting.location %></td></tr><% } %>
                  <% if (meeting.meeting_link) { %><tr><td class="text-muted">Link</td><td class="fw-semibold"><a href="<%= meeting.meeting_link %>" target="_blank">Join meeting</a></td></tr><% } %>
                </tbody>
              </table>
              <% if (meeting.agenda) { %><div><div class="text-muted" style="font-size:.72rem;text-transform:uppercase;font-weight:700;">Agenda</div><p style="font-size:.85rem;color:#374151;"><%= meeting.agenda %></p></div><% } %>
              <% if (meeting.cancel_reason) { %><div class="alert alert-danger border-0 mt-2" style="font-size:.82rem;"><strong>Cancelled:</strong> <%= meeting.cancel_reason %></div><% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <% if (['SCHEDULED','CONFIRMED'].includes(meeting.status) && !meeting.pendingRequest) { %>
          <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-arrow-repeat me-1"></i>Need a different time?</div>
              <form action="/student/meetings/<%= meeting.id %>/request-reschedule" method="POST">
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="font-size:.85rem;">Reason <span class="text-danger">*</span></label>
                  <textarea name="reason" class="form-control" rows="3" required placeholder="e.g. I have an academic examination at this time."></textarea>
                </div>
                <button type="submit" class="btn btn-outline-primary btn-sm fw-semibold"><i class="bi bi-send me-1"></i>Request reschedule</button>
              </form>
            </div>
          </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
