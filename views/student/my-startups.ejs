<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>My Startups — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <!-- ── Page Hero ── -->
      <div class="page-hero d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1><i class="bi bi-rocket-takeoff me-2"></i>My Startups</h1>
          <p>All your submitted startup ideas in one place</p>
        </div>
        <a href="/student/startup/new" class="btn btn-white fw-bold">
          <i class="bi bi-plus-lg me-1"></i> Submit New Idea
        </a>
      </div>

      <%- include('../layouts/flash') %>

      <!-- ── Search + Filter bar ── -->
      <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
        <div class="card-body py-3 px-4">
          <div class="row g-3 align-items-center">

            <!-- Search -->
            <div class="col-12 col-md-4">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="bi bi-search text-muted" style="font-size:.85rem;"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0"
                  placeholder="Search by name or domain…" style="font-size:.855rem;"/>
              </div>
            </div>

            <!-- Status filter -->
            <div class="col-6 col-md-2">
              <select id="filterStatus" class="form-select" style="font-size:.845rem;">
                <option value="">All status</option>
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
              </select>
            </div>

            <!-- Stage filter -->
            <div class="col-6 col-md-2">
              <select id="filterStage" class="form-select" style="font-size:.845rem;">
                <option value="">All stages</option>
                <option value="idea">Idea</option>
                <option value="prototype">Prototype</option>
                <option value="mvp">MVP</option>
                <option value="scaling">Scaling</option>
              </select>
            </div>

            <!-- Domain filter -->
            <div class="col-6 col-md-2">
              <select id="filterDomain" class="form-select" style="font-size:.845rem;">
                <option value="">All domains</option>
                <option value="EdTech">EdTech</option>
                <option value="HealthTech">HealthTech</option>
                <option value="FinTech">FinTech</option>
                <option value="AgriTech">AgriTech</option>
                <option value="E-Commerce">E-Commerce</option>
                <option value="SaaS">SaaS</option>
                <option value="AI/ML">AI / ML</option>
                <option value="IoT">IoT</option>
                <option value="Social Impact">Social Impact</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <!-- Result count + reset -->
            <div class="col-6 col-md-2 d-flex align-items-center justify-content-end gap-2">
              <span class="text-muted" id="resultCount" style="font-size:.78rem;white-space:nowrap;"></span>
              <button class="btn btn-outline-secondary btn-sm" id="resetFilters" style="font-size:.78rem;display:none;">
                <i class="bi bi-x-lg me-1"></i>Reset
              </button>
            </div>

          </div>
        </div>
      </div>

      <!-- ── Startup Cards Grid ── -->
      <% if (startups.length === 0) { %>

        <!-- Global empty state (no startups at all) -->
        <div class="card border-0 shadow-sm text-center py-5 px-4" style="border-radius:14px;">
          <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 mx-auto"
            style="width:72px;height:72px;background:var(--ip-red-pale);">
            <i class="bi bi-lightbulb text-primary" style="font-size:2rem;"></i>
          </div>
          <h5 class="fw-bold mb-1" style="color:#111;">No ideas submitted yet</h5>
          <p class="text-muted mb-4" style="font-size:.875rem;max-width:340px;margin:0 auto .75rem;">
            Your startup ideas will appear here once submitted.
          </p>
          <div>
            <a href="/student/startup/new" class="btn btn-primary fw-semibold px-4">
              <i class="bi bi-plus-lg me-1"></i> Submit Your First Idea
            </a>
          </div>
        </div>

      <% } else { %>

        <div class="row g-4" id="startupGrid">
          <% startups.forEach(s => { %>

          <div class="col-12 col-md-6 col-xl-4 startup-card-wrap"
            data-title="<%= s.title.toLowerCase() %>"
            data-domain="<%= s.domain %>"
            data-stage="<%= s.stage %>"
            data-status="<%= s.status %>">

            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;transition:transform .2s,box-shadow .2s;"
              onmouseenter="this.style.transform='translateY(-3px)';this.style.boxShadow='0 10px 28px rgba(139,26,26,.1)'"
              onmouseleave="this.style.transform='';this.style.boxShadow=''">

              <!-- Card top accent bar by status -->
              <div style="height:4px;border-radius:14px 14px 0 0;background:<%= s.status === 'approved' ? '#1a7a4a' : s.status === 'rejected' ? '#c0392b' : '#d97706' %>;"></div>

              <div class="card-body p-4 d-flex flex-column">

                <!-- Header row -->
                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                  <div class="d-flex align-items-center gap-3">
                    <!-- Domain icon circle -->
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                      style="width:44px;height:44px;background:var(--ip-red-pale);font-size:1.25rem;">
                      <%
                        const domainIcons = {
                          'EdTech':'📚','HealthTech':'🏥','FinTech':'💳','AgriTech':'🌾',
                          'E-Commerce':'🛒','SaaS':'☁️','AI/ML':'🤖','IoT':'📡',
                          'Social Impact':'🌍','Other':'🔧'
                        };
                      %><%= domainIcons[s.domain] || '🚀' %>
                    </div>
                    <div>
                      <h6 class="fw-bold mb-0" style="font-size:.95rem;color:#111;line-height:1.3;">
                        <%= s.title %>
                      </h6>
                      <span style="font-size:.75rem;color:#9ca3af;">
                        <i class="bi bi-calendar3 me-1"></i>
                        <%= new Date(s.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                      </span>
                    </div>
                  </div>
                  <!-- Status badge -->
                  <span class="badge badge-<%= s.status %> d-inline-flex align-items-center gap-1 flex-shrink-0">
                    <% if (s.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.6rem;"></i>
                    <% } else if (s.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.6rem;"></i>
                    <% } else { %><i class="bi bi-clock" style="font-size:.6rem;"></i><% } %>
                    <%= s.status %>
                  </span>
                </div>

                <!-- Description excerpt -->
                <p class="text-muted mb-3" style="font-size:.845rem;line-height:1.65;flex-grow:1;
                  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                  <%= s.description %>
                </p>

                <!-- Meta pills row -->
                <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                  <span class="badge badge-<%= s.stage %>"><%= s.stage %></span>
                  <span class="badge" style="background:#f1f5f9;color:#475569;font-size:.68rem;">
                    <i class="bi bi-tag me-1" style="font-size:.6rem;"></i><%= s.domain %>
                  </span>
                  <% if (s.pitch_deck_url) { %>
                    <span class="badge" style="background:#eff6ff;color:#1d4ed8;font-size:.68rem;">
                      <i class="bi bi-paperclip me-1" style="font-size:.6rem;"></i>Pitch deck
                    </span>
                  <% } %>
                </div>

                <!-- Admin remark preview -->
                <% if (s.admin_remark) { %>
                  <div class="p-2 rounded-2 mb-3 d-flex align-items-start gap-2"
                    style="background:<%= s.status === 'approved' ? '#f0fdf4' : '#fee2e2' %>;font-size:.76rem;color:<%= s.status === 'approved' ? '#065f46' : '#991b1b' %>;">
                    <i class="bi bi-chat-left-quote flex-shrink-0 mt-1" style="font-size:.7rem;"></i>
                    <span class="text-truncate"><%= s.admin_remark %></span>
                  </div>
                <% } %>

                <!-- Footer action -->
                <div class="pt-2 border-top d-flex align-items-center justify-content-between"
                  style="border-color:#e3e7ef !important;">
                  <div class="d-flex align-items-center gap-3" style="font-size:.75rem;color:#9ca3af;">
                    <span><i class="bi bi-chat-dots me-1"></i><%= s.feedback_count || 0 %> feedback</span>
                    <span><i class="bi bi-bar-chart me-1"></i><%= s.progress_count || 0 %> updates</span>
                  </div>
                  <a href="/student/startup/<%= s.id %>"
                    class="btn btn-outline-primary btn-sm fw-semibold" style="font-size:.78rem;">
                    View details <i class="bi bi-arrow-right ms-1"></i>
                  </a>
                </div>

              </div>
            </div>
          </div>

          <% }); %>
        </div><!-- /row -->

        <!-- Filter empty state (shown by JS) -->
        <div id="filterEmpty" class="text-center py-5 d-none">
          <i class="bi bi-funnel" style="font-size:2.5rem;color:#d1d5db;display:block;margin-bottom:.75rem;"></i>
          <h6 class="fw-bold" style="color:#111;">No startups match your filters</h6>
          <p class="text-muted mb-3" style="font-size:.855rem;">Try adjusting or resetting the filters.</p>
          <button class="btn btn-outline-secondary btn-sm" onclick="resetAll()">
            <i class="bi bi-x-lg me-1"></i>Reset filters
          </button>
        </div>

      <% } %>

    </div><!-- /container -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
  const cards  = document.querySelectorAll('.startup-card-wrap');
  const search = document.getElementById('searchInput');
  const fSt    = document.getElementById('filterStatus');
  const fSg    = document.getElementById('filterStage');
  const fDm    = document.getElementById('filterDomain');
  const count  = document.getElementById('resultCount');
  const reset  = document.getElementById('resetFilters');
  const empty  = document.getElementById('filterEmpty');

  if (!cards.length) return;

  function filter() {
    const q   = search  ? search.value.toLowerCase().trim() : '';
    const st  = fSt     ? fSt.value   : '';
    const sg  = fSg     ? fSg.value   : '';
    const dm  = fDm     ? fDm.value   : '';
    const hasFilter = q || st || sg || dm;

    let visible = 0;
    cards.forEach(c => {
      const titleMatch  = c.dataset.title.includes(q);
      const domainMatch = c.dataset.title.includes(q) || c.dataset.domain.toLowerCase().includes(q);
      const stMatch     = !st || c.dataset.status  === st;
      const sgMatch     = !sg || c.dataset.stage   === sg;
      const dmMatch     = !dm || c.dataset.domain  === dm;
      const show        = (titleMatch || domainMatch) && stMatch && sgMatch && dmMatch;
      c.style.display   = show ? '' : 'none';
      if (show) visible++;
    });

    if (count) count.textContent = visible + ' result' + (visible !== 1 ? 's' : '');
    if (reset) reset.style.display = hasFilter ? '' : 'none';
    if (empty) empty.classList.toggle('d-none', visible > 0);
  }

  if (search) search.addEventListener('input', filter);
  if (fSt)    fSt.addEventListener('change', filter);
  if (fSg)    fSg.addEventListener('change', filter);
  if (fDm)    fDm.addEventListener('change', filter);
  if (reset)  reset.addEventListener('click', resetAll);

  filter(); // init count

  window.resetAll = function() {
    if (search) search.value = '';
    if (fSt)    fSt.value    = '';
    if (fSg)    fSg.value    = '';
    if (fDm)    fDm.value    = '';
    filter();
  };
})();
</script>
</body>
</html>
