<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= startup.title %> — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="app-layout">
  <%- include('../layouts/sidebar') %>

  <main class="app-main">
    <div class="container-fluid px-4">

      <div class="page-hero">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
          <div>
            <h1 class="mb-2"><i class="bi bi-rocket-takeoff me-2"></i><%= startup.title %></h1>
            <div class="d-flex align-items-center flex-wrap gap-2">
              <span class="badge bg-white text-dark fw-semibold" style="font-size:.75rem;">
                <i class="bi bi-tag me-1"></i><%= startup.domain %>
              </span>
              <span class="badge badge-<%= startup.stage %>"><%= startup.stage %></span>
              <span class="badge badge-<%= startup.status %> d-inline-flex align-items-center gap-1">
                <% if (startup.status === 'approved') { %><i class="bi bi-check-circle-fill" style="font-size:.65rem;"></i>
                <% } else if (startup.status === 'rejected') { %><i class="bi bi-x-circle-fill" style="font-size:.65rem;"></i>
                <% } else { %><i class="bi bi-clock" style="font-size:.65rem;"></i><% } %>
                <%= startup.status %>
              </span>
            </div>
          </div>
          <a href="/student/dashboard" class="btn align-self-start">
            <i class="bi bi-arrow-left me-1"></i> Back
          </a>
        </div>
      </div>

      <%- include('../layouts/flash') %>

      <% if (startup.admin_remark) { %>
        <div class="alert d-flex align-items-start gap-3 border-0 rounded-3 mb-4 py-3"
          style="background:<%= startup.status === 'approved' ? '#f0fdf4' : '#fee2e2' %>;
                 border-left:4px solid <%= startup.status === 'approved' ? '#22c55e' : '#c0392b' %> !important;
                 border-radius:0 10px 10px 0 !important;">
          <i class="bi bi-<%= startup.status === 'approved' ? 'check-circle-fill text-success' : 'exclamation-triangle-fill text-danger' %> flex-shrink-0 mt-1"></i>
          <div style="font-size:.875rem;">
            <strong>Admin remark:</strong> <%= startup.admin_remark %>
          </div>
        </div>
      <% } %>

      <div class="row g-4 align-items-start">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-file-text me-1"></i>Startup details</div>
              <p style="font-size:.9rem;color:#374151;line-height:1.75;"><%= startup.description %></p>

              <% if (startup.pitch_deck_url) { %>
                <a href="<%= startup.pitch_deck_url %>" target="_blank" class="btn btn-outline-primary btn-sm fw-semibold">
                  <i class="bi bi-file-earmark-slides me-1"></i> View Pitch Deck
                </a>
              <% } else { %>
                <div class="d-inline-flex align-items-center gap-2 py-2 px-3 rounded-3" style="background:#f3f5f9;font-size:.82rem;color:#9ca3af;">
                  <i class="bi bi-file-earmark-x"></i> No pitch deck uploaded
                </div>
              <% } %>
            </div>
          </div>

          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-people me-1"></i>Assigned mentors</div>
              <% if (mentors.length === 0) { %>
                <div class="d-flex align-items-center gap-3 py-2 px-3 rounded-3" style="background:#f3f5f9;font-size:.845rem;color:#6b7280;">
                  <i class="bi bi-person-dash" style="font-size:1.1rem;"></i>
                  <span>No mentor assigned yet. Admin will assign one once your startup is approved.</span>
                </div>
              <% } else { %>
                <div class="list-group list-group-flush">
                  <% mentors.forEach(m => { %>
                    <div class="list-group-item px-0 py-3 d-flex align-items-center gap-3 border-0" style="border-bottom:1px solid #e3e7ef !important;">
                      <div class="avatar-circle flex-shrink-0" style="background:var(--ip-red); color:#fff; font-weight:700;"><%= m.name.charAt(0).toUpperCase() %></div>
                      <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold" style="font-size:.875rem;color:#111;"><%= m.name %></div>
                        <div class="text-muted" style="font-size:.78rem;"><%= m.email %></div>
                      </div>
                      <span class="badge badge-mentor">Mentor</span>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-chat-square-text me-1"></i>Mentor feedback</div>
              <% if (feedback.length === 0) { %>
                <div class="text-center py-4">
                  <i class="bi bi-chat-dots" style="font-size:2rem;color:#d1d5db;display:block;margin-bottom:.75rem;"></i>
                  <p class="text-muted mb-0" style="font-size:.845rem;">No feedback yet from your mentor.</p>
                </div>
              <% } else { %>
                <div class="d-flex flex-column gap-3">
                  <% feedback.forEach((f) => { %>
                    <div class="p-3 rounded-3" style="background:#f8f9fa;border:1px solid #e3e7ef;">
                      <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="avatar-circle flex-shrink-0" style="width:28px;height:28px;font-size:.72rem;">
                          <%= f.mentor_name.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <span class="fw-semibold" style="font-size:.82rem;color:#111;"><%= f.mentor_name %></span>
                          <span class="text-muted ms-2" style="font-size:.75rem;">
                            <i class="bi bi-calendar3 me-1"></i><%= new Date(f.created_at).toLocaleDateString('en-IN') %>
                          </span>
                        </div>
                      </div>
                      <p class="mb-0" style="font-size:.855rem;color:#374151;line-height:1.65;"><%= f.feedback %></p>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-graph-up me-1"></i>Progress updates</div>
              <form action="/student/startup/<%= startup.id %>/progress" method="POST" class="mb-4">
                <div class="mb-2">
                  <textarea name="description" class="form-control" rows="3" placeholder="Share a progress update..." required style="font-size:.855rem;"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm fw-semibold px-3">
                  <i class="bi bi-send me-1"></i> Post Update
                </button>
              </form>

              <% if (progress.length > 0) { %>
                <hr style="border-color:#e3e7ef;" class="my-3"/>
                <div class="d-flex flex-column gap-3">
                  <% progress.forEach((p, i) => { %>
                    <div class="d-flex gap-3">
                      <div class="d-flex flex-column align-items-center flex-shrink-0" style="width:18px;">
                        <div class="rounded-circle flex-shrink-0" style="width:10px;height:10px;background:var(--ip-red);margin-top:4px;border:2px solid #fff;box-shadow:0 0 0 2px var(--ip-red);"></div>
                        <% if (i < progress.length - 1) { %>
                          <div style="width:2px;flex:1;background:#e3e7ef;margin-top:4px;"></div>
                        <% } %>
                      </div>
                      <div class="pb-3 flex-grow-1">
                        <div class="text-muted mb-1" style="font-size:.73rem;font-weight:600;">
                          <i class="bi bi-calendar3 me-1"></i><%= new Date(p.created_at).toLocaleDateString('en-IN') %>
                        </div>
                        <div class="p-3 rounded-3" style="background:#f8f9fa;border:1px solid #e3e7ef;font-size:.845rem;"><%= p.description %></div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="text-center py-3">
                  <i class="bi bi-bar-chart" style="font-size:1.8rem;color:#d1d5db;display:block;"></i>
                  <p class="text-muted mb-0" style="font-size:.82rem;">No updates yet.</p>
                </div>
              <% } %>
            </div>
          </div>

          <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
              <div class="card-section-title"><i class="bi bi-cash-coin me-1"></i>Request funding</div>
              <% if (startup.status !== 'approved') { %>
                <div class="d-flex align-items-start gap-3 p-3 rounded-3" style="background:#fef9ec;border:1px solid #fde68a;">
                  <i class="bi bi-lock-fill flex-shrink-0 mt-1" style="color:#d97706;"></i>
                  <div style="font-size:.845rem;color:#92400e;">Available only after <span class="badge badge-approved">approved</span>.</div>
                </div>
              <% } else { %>
                <form action="/student/startup/<%= startup.id %>/funding" method="POST" enctype="multipart/form-data">
                  <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:.845rem;">Amount (₹) <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light border-end-0">₹</span>
                      <input type="number" name="amount" class="form-control border-start-0" placeholder="50,000" min="1" required/>
                    </div>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:.845rem;">Purpose <span class="text-danger">*</span></label>
                    <textarea name="purpose" class="form-control" rows="3" required style="font-size:.855rem;"></textarea>
                  </div>
                  <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:.845rem;">Proposal <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="file" name="proposal" class="form-control" accept=".pdf,.doc,.docx" style="font-size:.845rem;"/>
                  </div>
                  <button type="submit" class="btn btn-success btn-sm fw-semibold w-100" style="background:#1a7a4a;">Submit Request</button>
                </form>

                <% if (typeof funding !== 'undefined' && funding.length > 0) { %>
                  <hr class="my-3"/>
                  <div class="fw-bold mb-2 text-uppercase text-muted" style="font-size:.7rem;">Previous requests</div>
                  <div class="d-flex flex-column gap-2">
                    <% funding.forEach(f => { %>
                      <div class="p-3 rounded-3 d-flex align-items-start justify-content-between gap-2" style="background:#f8f9fa;border:1px solid #e3e7ef;">
                        <div>
                          <div class="fw-bold" style="font-size:.9rem;">₹<%= Number(f.amount_requested).toLocaleString('en-IN') %></div>
                          <div class="text-muted" style="font-size:.78rem;"><%= f.purpose %></div>
                        </div>
                        <span class="badge badge-<%= f.status %>"><%= f.status %></span>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>