<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Forgot Password — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="p-0 m-0">

<div class="auth-page">

  <!-- ── Left panel ── -->
  <div class="auth-left d-none d-lg-flex flex-column align-items-center justify-content-center">
    <div class="al-content">
      <div class="mb-3" style="font-size:3.5rem;">🔐</div>
      <div class="al-logo">Forgot Password?</div>
      <div class="al-tag">No worries — we'll send you a secure reset link</div>

      <div class="d-flex flex-column gap-3 mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,.2);">
        <div class="d-flex align-items-center gap-3" style="color:rgba(255,255,255,.85);font-size:.875rem;">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:32px;height:32px;background:rgba(255,255,255,.15);">
            <i class="bi bi-envelope text-white" style="font-size:.8rem;"></i>
          </div>
          Enter the email linked to your account
        </div>
        <div class="d-flex align-items-center gap-3" style="color:rgba(255,255,255,.85);font-size:.875rem;">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:32px;height:32px;background:rgba(255,255,255,.15);">
            <i class="bi bi-link-45deg text-white" style="font-size:.8rem;"></i>
          </div>
          Check your inbox for the reset link
        </div>
        <div class="d-flex align-items-center gap-3" style="color:rgba(255,255,255,.85);font-size:.875rem;">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
            style="width:32px;height:32px;background:rgba(255,255,255,.15);">
            <i class="bi bi-shield-lock text-white" style="font-size:.8rem;"></i>
          </div>
          Link expires in 1 hour for your security
        </div>
      </div>
    </div>
  </div>

  <!-- ── Right panel ── -->
  <div class="auth-right">

    <!-- Mobile logo -->
    <div class="text-center mb-4 d-lg-none">
      <span style="font-size:2rem;">🎓</span>
      <div style="font-weight:800;font-size:1.4rem;color:var(--ip-red);">IncuPortal</div>
    </div>

    <div class="mb-1" style="font-size:2rem;">🔐</div>
    <h2 class="ar-title">Forgot your password?</h2>
    <p class="ar-sub">Enter your registered email and we'll send you a reset link.</p>

    <!-- Success alert -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert d-flex align-items-start gap-3 border-0 rounded-3 mb-4"
        style="background:#f0fdf4;border-left:4px solid #22c55e !important;border-radius:0 10px 10px 0 !important;">
        <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" style="color:#1a7a4a;font-size:.95rem;"></i>
        <div style="font-size:.875rem;color:#065f46;">
          <strong>Email sent!</strong> <%= success %>
        </div>
      </div>
    <% } %>

    <!-- Error alert -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert d-flex align-items-start gap-3 border-0 rounded-3 mb-4"
        style="background:#fee2e2;border-left:4px solid #c0392b !important;border-radius:0 10px 10px 0 !important;">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" style="color:#c0392b;font-size:.95rem;"></i>
        <div style="font-size:.875rem;color:#991b1b;"><%= error %></div>
      </div>
    <% } %>

    <!-- Form — hidden after success -->
    <% if (typeof success === 'undefined' || !success) { %>
      <form action="/auth/forgot-password" method="POST">

        <div class="mb-4">
          <label class="form-label fw-semibold" for="email" style="font-size:.855rem;">
            Email address
          </label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-envelope text-secondary" style="font-size:.85rem;"></i>
            </span>
            <input type="email" id="email" name="email"
              class="form-control border-start-0 ps-0"
              placeholder="you@college.edu" required autofocus/>
          </div>
          <div class="form-text" style="font-size:.75rem;">
            We'll send a reset link to this address if it's registered.
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold"
          style="font-size:.95rem;letter-spacing:.03em;">
          <i class="bi bi-send me-2"></i>Send Reset Link
        </button>

      </form>
    <% } else { %>
      <!-- Post-send CTA -->
      <div class="p-4 rounded-3 text-center mb-3"
        style="background:#f0fdf4;border:1px solid #bbf7d0;">
        <i class="bi bi-envelope-check" style="font-size:2rem;color:#1a7a4a;display:block;margin-bottom:.5rem;"></i>
        <div class="fw-semibold mb-1" style="font-size:.9rem;color:#065f46;">Check your inbox</div>
        <div style="font-size:.8rem;color:#166534;">
          The reset link is valid for <strong>1 hour</strong>. Check your spam folder if you don't see it.
        </div>
      </div>
      <a href="/auth/forgot-password" class="btn btn-outline-secondary w-100 btn-sm fw-semibold" style="font-size:.845rem;">
        <i class="bi bi-arrow-repeat me-1"></i>Resend link
      </a>
    <% } %>

    <p class="text-center mt-4 mb-0" style="font-size:.875rem;color:#6b7280;">
      Remembered your password?
      <a href="/auth/login" class="fw-semibold text-decoration-none">Sign in</a>
    </p>
    <p class="text-center mt-2 mb-0" style="font-size:.875rem;color:#6b7280;">
      Don't have an account?
      <a href="/auth/register" class="fw-semibold text-decoration-none">Register here</a>
    </p>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
