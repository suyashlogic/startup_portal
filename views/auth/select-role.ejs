<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Choose Role — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="p-0 m-0" style="background:linear-gradient(145deg,#3d0909 0%,var(--ip-red,#8b1a1a) 50%,#c0392b 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem;">

<div class="w-100" style="max-width:540px;">

  <!-- Header above card -->
  <div class="text-center mb-4">
    <div style="font-size:2.5rem;">🎓</div>
    <h1 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.75rem;font-weight:900;color:#fff;margin-top:.5rem;">One Last Step</h1>
    <p style="color:rgba(255,255,255,.72);font-size:.9rem;margin:0;">Tell us who you are so we can set up your dashboard</p>
  </div>

  <!-- Card -->
  <div class="card border-0 shadow-lg" style="border-radius:16px;">
    <div class="card-body p-4">

      <%- include('../layouts/flash') %>

      <form action="/auth/select-role" method="POST" id="roleForm">
        <div class="row g-3 mb-4">

          <!-- Student -->
          <div class="col-6">
            <label class="role-option d-block h-100">
              <input type="radio" name="role" value="student" required class="role-radio"/>
              <div class="role-box">
                <span class="rb-icon">👨‍🎓</span>
                <div class="rb-title">Student</div>
                <div class="rb-desc">Submit ideas, track approvals &amp; request funding</div>
                <ul class="list-unstyled mt-3 mb-0 text-start" style="font-size:.73rem;color:#6b7280;">
                  <li class="d-flex align-items-center gap-1 mb-1"><i class="bi bi-check2-circle text-success"></i> Submit startup ideas</li>
                  <li class="d-flex align-items-center gap-1 mb-1"><i class="bi bi-check2-circle text-success"></i> Apply for seed funding</li>
                  <li class="d-flex align-items-center gap-1"><i class="bi bi-check2-circle text-success"></i> Track milestones</li>
                </ul>
              </div>
            </label>
          </div>

          <!-- Mentor -->
          <div class="col-6">
            <label class="role-option d-block h-100">
              <input type="radio" name="role" value="mentor" required class="role-radio"/>
              <div class="role-box">
                <span class="rb-icon">🧑‍💼</span>
                <div class="rb-title">Mentor</div>
                <div class="rb-desc">Guide assigned startups &amp; review progress</div>
                <ul class="list-unstyled mt-3 mb-0 text-start" style="font-size:.73rem;color:#6b7280;">
                  <li class="d-flex align-items-center gap-1 mb-1"><i class="bi bi-check2-circle text-success"></i> Review startup ideas</li>
                  <li class="d-flex align-items-center gap-1 mb-1"><i class="bi bi-check2-circle text-success"></i> Give structured feedback</li>
                  <li class="d-flex align-items-center gap-1"><i class="bi bi-check2-circle text-success"></i> Guide founders</li>
                </ul>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold"
          style="font-size:.95rem;letter-spacing:.03em;">
          Continue &nbsp;<i class="bi bi-arrow-right"></i>
        </button>
      </form>

    </div>
  </div>

  <p class="text-center mt-3 mb-0" style="color:rgba(255,255,255,.5);font-size:.78rem;">
    You can update your role later in account settings
  </p>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('.role-radio').forEach(r=>{
  r.addEventListener('change',()=>{
    document.querySelectorAll('.role-box').forEach(b=>b.classList.remove('selected'));
    r.closest('label').querySelector('.role-box').classList.add('selected');
  });
});
</script>
</body>
</html>
