<!DOCTYPE html>
<html lang="en" ng-app="resetApp">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Reset Password — IncuPortal</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular.min.js"></script>
</head>
<body class="p-0 m-0">

<div class="auth-page" ng-controller="ResetCtrl">

  <!-- ── Left panel ── -->
  <div class="auth-left d-none d-lg-flex flex-column align-items-center justify-content-center">
    <div class="al-content">
      <div class="mb-3" style="font-size:3.5rem;">🔑</div>
      <div class="al-logo">Set New Password</div>
      <div class="al-tag">Choose a strong password to secure your account</div>

      <!-- Password rules legend -->
      <div class="d-flex flex-column gap-2 mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,.2);">
        <div style="color:rgba(255,255,255,.7);font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;margin-bottom:.25rem;">
          Password requirements
        </div>
        <div class="d-flex align-items-center gap-2" style="color:rgba(255,255,255,.82);font-size:.845rem;">
          <i class="bi bi-check2-circle" style="color:#4ade80;font-size:.85rem;"></i> At least 8 characters
        </div>
        <div class="d-flex align-items-center gap-2" style="color:rgba(255,255,255,.82);font-size:.845rem;">
          <i class="bi bi-check2-circle" style="color:#4ade80;font-size:.85rem;"></i> Uppercase &amp; lowercase letters
        </div>
        <div class="d-flex align-items-center gap-2" style="color:rgba(255,255,255,.82);font-size:.845rem;">
          <i class="bi bi-check2-circle" style="color:#4ade80;font-size:.85rem;"></i> At least one number
        </div>
        <div class="d-flex align-items-center gap-2" style="color:rgba(255,255,255,.82);font-size:.845rem;">
          <i class="bi bi-check2-circle" style="color:#4ade80;font-size:.85rem;"></i> Special character (@$!%*?&amp;)
        </div>
      </div>
    </div>
  </div>

  <!-- ── Right panel ── -->
  <div class="auth-right">

    <!-- Mobile logo -->
    <div class="text-center mb-4 d-lg-none">
      <span style="font-size:2rem;">🎓</span>
      <div style="font-weight:800;font-size:1.4rem;color:var(--ip-red);">IncuPortal</div>
    </div>

    <div class="mb-1" style="font-size:2rem;">🔑</div>
    <h2 class="ar-title">Set new password</h2>
    <p class="ar-sub">Choose a strong password for your IncuPortal account.</p>

    <!-- Error alert (invalid / expired token) -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert d-flex align-items-start gap-3 border-0 rounded-3 mb-4"
        style="background:#fee2e2;border-left:4px solid #c0392b !important;border-radius:0 10px 10px 0 !important;">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" style="color:#c0392b;font-size:.95rem;"></i>
        <div style="font-size:.875rem;color:#991b1b;">
          <strong>Link invalid.</strong> <%= error %>
          <div class="mt-2">
            <a href="/auth/forgot-password" class="fw-semibold text-decoration-none" style="color:#c0392b;">
              Request a new reset link →
            </a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Success alert -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert d-flex align-items-start gap-3 border-0 rounded-3 mb-4"
        style="background:#f0fdf4;border-left:4px solid #22c55e !important;border-radius:0 10px 10px 0 !important;">
        <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" style="color:#1a7a4a;font-size:.95rem;"></i>
        <div style="font-size:.875rem;color:#065f46;">
          <strong>Password updated!</strong> <%= success %>
        </div>
      </div>
      <a href="/auth/login" class="btn btn-primary w-100 py-2 fw-bold" style="font-size:.95rem;letter-spacing:.03em;">
        <i class="bi bi-box-arrow-in-right me-2"></i>Go to Sign In
      </a>

    <!-- Form — only shown when token is valid and no success yet -->
    <% } else if (typeof error === 'undefined' || !error) { %>

      <form name="resetForm" action="/auth/reset-password/<%= token %>" method="POST" novalidate ng-submit="submit()">

        <!-- New password -->
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:.855rem;">
            New password <span class="text-danger">*</span>
          </label>
          <div class="input-group pw-wrap">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-lock text-secondary" style="font-size:.85rem;"></i>
            </span>
            <input ng-attr-type="{{ showPw ? 'text' : 'password' }}"
              name="password" ng-model="form.password"
              class="form-control border-start-0 ps-0"
              placeholder="Min. 8 characters"
              required ng-minlength="8"
              ng-change="checkStrength()"
              style="padding-right:2.75rem;"/>
            <button type="button" class="pw-eye" ng-click="showPw=!showPw">
              <i ng-class="showPw ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
            </button>
          </div>

          <!-- Strength bar -->
          <div ng-show="form.password" class="mt-1">
            <div class="progress" style="height:4px;border-radius:99px;">
              <div class="progress-bar" ng-style="{width:strength.pct,background:strength.color}"
                style="transition:width .3s,background .3s;"></div>
            </div>
            <small ng-show="form.password" ng-style="{color:strength.color}" class="fw-semibold" style="font-size:.72rem;">
              {{strength.label}}
            </small>
          </div>
        </div>

        <!-- Password rules checklist -->
        <div class="rounded-3 p-3 mb-3" style="background:#f8f9fa;border:1px solid #e3e7ef;" ng-show="form.password">
          <div class="row g-1" style="font-size:.73rem;">
            <div class="col-6" ng-class="{'text-success':pwRules.lower,'text-secondary':!pwRules.lower}">
              <i ng-class="pwRules.lower ? 'bi bi-check-circle-fill' : 'bi bi-circle'"></i> Lowercase
            </div>
            <div class="col-6" ng-class="{'text-success':pwRules.upper,'text-secondary':!pwRules.upper}">
              <i ng-class="pwRules.upper ? 'bi bi-check-circle-fill' : 'bi bi-circle'"></i> Uppercase
            </div>
            <div class="col-6" ng-class="{'text-success':pwRules.digit,'text-secondary':!pwRules.digit}">
              <i ng-class="pwRules.digit ? 'bi bi-check-circle-fill' : 'bi bi-circle'"></i> Number
            </div>
            <div class="col-6" ng-class="{'text-success':pwRules.special,'text-secondary':!pwRules.special}">
              <i ng-class="pwRules.special ? 'bi bi-check-circle-fill' : 'bi bi-circle'"></i> Special char
            </div>
          </div>
        </div>

        <!-- Confirm password -->
        <div class="mb-4">
          <label class="form-label fw-semibold" style="font-size:.855rem;">
            Confirm password <span class="text-danger">*</span>
          </label>
          <div class="input-group pw-wrap">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-lock-fill text-secondary" style="font-size:.85rem;"></i>
            </span>
            <input ng-attr-type="{{ showCp ? 'text' : 'password' }}"
              name="confirmPassword" ng-model="form.confirmPassword"
              class="form-control border-start-0 ps-0"
              placeholder="Repeat password"
              required style="padding-right:2.75rem;"/>
            <button type="button" class="pw-eye" ng-click="showCp=!showCp">
              <i ng-class="showCp ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
            </button>
          </div>

          <div class="f-err mt-1"
            ng-show="resetForm.confirmPassword.$touched && form.confirmPassword && form.password !== form.confirmPassword">
            <i class="bi bi-exclamation-triangle-fill"></i> Passwords do not match.
          </div>
          <div style="color:#1a7a4a;font-size:.75rem;margin-top:.3rem;font-weight:600;"
            ng-show="resetForm.confirmPassword.$touched && form.confirmPassword && form.password === form.confirmPassword">
            <i class="bi bi-check-circle-fill"></i> Passwords match
          </div>
        </div>

        <button type="submit"
          class="btn btn-primary w-100 py-2 fw-bold"
          style="font-size:.95rem;letter-spacing:.03em;"
          ng-disabled="resetForm.$invalid || form.password !== form.confirmPassword || !isStrong()">
          <i class="bi bi-shield-lock me-2"></i>Reset Password
        </button>

      </form>

    <% } %>

    <p class="text-center mt-4 mb-0" style="font-size:.875rem;color:#6b7280;">
      Remembered your password?
      <a href="/auth/login" class="fw-semibold text-decoration-none">Sign in</a>
    </p>

  </div>
</div>

<script>
angular.module('resetApp',[]).controller('ResetCtrl',['$scope',function($s){
  $s.form={}; $s.showPw=false; $s.showCp=false;
  $s.pwRules={lower:false,upper:false,digit:false,special:false};
  $s.strength={pct:'0%',color:'#e2e8f0',label:''};

  $s.checkStrength=function(){
    var pw=$s.form.password||'';
    $s.pwRules={lower:/[a-z]/.test(pw),upper:/[A-Z]/.test(pw),digit:/\d/.test(pw),special:/[@$!%*?&]/.test(pw)};
    var sc=Object.values($s.pwRules).filter(Boolean).length;
    if(pw.length>=8)sc=Math.min(sc+1,5);
    var m=[{pct:'20%',color:'#c0392b',label:'Very weak'},{pct:'40%',color:'#e67e22',label:'Weak'},{pct:'60%',color:'#f1c40f',label:'Fair'},{pct:'80%',color:'#27ae60',label:'Strong'},{pct:'100%',color:'#1a7a4a',label:'Very strong'}];
    $s.strength=m[Math.max(0,sc-1)]||m[0];
  };

  $s.isStrong=function(){
    var pw=$s.form.password||'';
    return pw.length>=8&&/[a-z]/.test(pw)&&/[A-Z]/.test(pw)&&/\d/.test(pw)&&/[@$!%*?&]/.test(pw);
  };

  $s.submit=function(){
    angular.forEach($s.resetForm,function(f){if(f&&typeof f.$setTouched==='function')f.$setTouched();});
    if($s.resetForm.$invalid)return;
    if($s.form.password!==$s.form.confirmPassword)return;
    if(!$s.isStrong())return;
    document.querySelector('form[name="resetForm"]').submit();
  };
}]);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
